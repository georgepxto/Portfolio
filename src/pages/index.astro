---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ContributionGraph from '../components/ContributionGraph.astro';
import HatchBand from '../components/HatchBand.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectCta from '../components/ProjectCta.astro';
import FilterPills from '../components/FilterPills.astro';
import GridRow from '../components/GridRow.astro';
import StackMarquee from '../components/StackMarquee.astro';
import LabList from '../components/LabList.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import StackList from '../components/StackList.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import { lab } from '../data/lab';
import { services } from '../data/services';
import { stack } from '../data/stack';
import { guarantees, processSteps } from '../data/process';
import { beforeAfter } from '../data/before-after';
import { getFeaturedProjects } from '../lib/projects';
import { getContributions } from '../lib/github';
import { fullName, githubUrl, site, whatsappNumber } from '../config/site';

const projects = await getFeaturedProjects();
const projectFilters = [
  { value: 'sistemas', label: 'Sistemas' },
  { value: 'sites', label: 'Sites' },
  { value: 'produtos', label: 'Produtos próprios' },
];
const ctaAfter = Math.min(2, projects.length);
const contributions = await getContributions();

const title = `${fullName} · ${site.role} em ${site.city}, ${site.state}`;
const description =
  'Desenvolvedor web em Parnaíba, PI. Sistemas de gestão, produtos SaaS e sites para empresas, do banco de dados à interface.';

const homeUrl = new URL('/', Astro.site).href;
const address = {
  '@type': 'PostalAddress',
  addressLocality: site.city,
  addressRegion: site.state,
  addressCountry: site.country,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${homeUrl}#pessoa`,
      name: fullName,
      jobTitle: site.role,
      url: homeUrl,
      sameAs: [githubUrl],
      address,
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${homeUrl}#servico`,
      name: `${fullName} · ${site.role}`,
      url: homeUrl,
      telephone: `+${whatsappNumber}`,
      address,
      areaServed: [site.city, site.stateName, 'Brasil'],
    },
  ],
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <Hero />

  <HatchBand dimension />

  {
    contributions && (
      <>
        <ContributionGraph data={contributions} dimension />
        <HatchBand />
      </>
    )
  }

  <Section
    id="trabalhos"
    dimension={!contributions}
    number="01"
    title="Trabalhos selecionados"
    subtitle="Sistemas e sites para clientes, propostas e produtos próprios."
  >
    <GridRow>
      <div class="filter-row">
        <FilterPills label="Filtrar trabalhos" target="lista-trabalhos" options={projectFilters} />
      </div>
    </GridRow>
    <div id="lista-trabalhos" class="project-list">
      {projects.slice(0, ctaAfter).map((project, index) => <ProjectCard project={project} index={index + 1} />)}
      <ProjectCta />
      {projects.slice(ctaAfter).map((project, index) => <ProjectCard project={project} index={index + ctaAfter + 1} />)}
      <GridRow data-filter-empty hidden={projects.length > 0}>
        <p class="empty mono">Nenhum projeto nesta categoria por enquanto.</p>
      </GridRow>
    </div>
  </Section>

  <HatchBand />

  <Section id="como-funciona" number="02" title="Como funciona" subtitle="Da primeira mensagem ao sistema no ar.">
    <ProcessSteps steps={processSteps} guarantees={guarantees} />
  </Section>

  <HatchBand />

  <Section id="servicos" number="03" title="Serviços" subtitle="O que posso fazer pela sua empresa.">
    <ServicesGrid items={services} />
  </Section>

  <HatchBand />

  <Section id="antes-e-depois" number="04" title="Antes e depois" subtitle="Como era e como ficou em cada projeto.">
    <BeforeAfter items={beforeAfter} />
  </Section>

  <HatchBand />

  <Section
    id="laboratorio"
    number="05"
    title="Laboratório"
    subtitle="Projetos pessoais e ferramentas que fiz para uso próprio."
  >
    <LabList items={lab} />
  </Section>

  <HatchBand />

  <Section id="sobre" number="06" title="Sobre" subtitle={`${site.role} em ${site.city}, ${site.state}.`}>
    <About />
  </Section>

  <HatchBand />

  <Section id="stack" number="07" title="Stack" subtitle="Ferramentas que uso nos projetos desta página.">
    <StackList groups={stack} />
  </Section>

  <StackMarquee />

  <HatchBand />

  <Contact />
</BaseLayout>

<style>
  .filter-row {
    padding: 12px 16px;
  }

  .empty {
    padding: 24px 16px;
    font-size: 13px;
    color: var(--text-muted);
  }
</style>
