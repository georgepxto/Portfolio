---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ContributionGraph from '../components/ContributionGraph.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectCta from '../components/ProjectCta.astro';
import FilterPills from '../components/FilterPills.astro';
import ComponentCard from '../components/ComponentCard.astro';
import StackMarquee from '../components/StackMarquee.astro';
import LabList from '../components/LabList.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import StackList from '../components/StackList.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import { lab } from '../data/lab';
import { services } from '../data/services';
import { stack } from '../data/stack';
import { guarantees, processSteps } from '../data/process';
import { beforeAfter } from '../data/before-after';
import { getFeaturedProjects } from '../lib/projects';
import { getContributionStats, getContributions } from '../lib/github';
import { components, componentsRepoUrl } from '../data/components';
import { fullName, githubUrl, site, whatsappNumber } from '../config/site';

const projects = await getFeaturedProjects();
const projectFilters = [
  { value: 'sistemas', label: 'Sistemas' },
  { value: 'sites', label: 'Sites' },
  { value: 'produtos', label: 'Produtos próprios' },
];
const ctaAfter = Math.min(2, projects.length);
const contributions = await getContributions();
const recentWeeks = contributions?.weeks.slice(-26) ?? [];
const recentStats = getContributionStats(recentWeeks);
const homeComponents = components.filter((component) => component.home);

const years = projects.map((project) => Number(project.data.year)).filter(Number.isFinite);
const yearRange = years.length ? (Math.min(...years) === Math.max(...years) ? `${Math.min(...years)}` : `${Math.min(...years)}–${Math.max(...years)}`) : '';
const projectInfo = `${String(projects.length).padStart(2, '0')} ${projects.length === 1 ? 'projeto' : 'projetos'}${yearRange ? ` · ${yearRange}` : ''}`;

const title = `${fullName} · ${site.role} em ${site.city}, ${site.state}`;
const description =
  'Desenvolvedor web em Parnaíba, PI. Sistemas de gestão, produtos SaaS e sites para empresas, do banco de dados à interface.';

const homeUrl = new URL('/', Astro.site).href;
const address = {
  '@type': 'PostalAddress',
  addressLocality: site.city,
  addressRegion: site.state,
  addressCountry: site.country,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${homeUrl}#pessoa`,
      name: fullName,
      jobTitle: site.role,
      url: homeUrl,
      sameAs: [githubUrl],
      address,
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${homeUrl}#servico`,
      name: `${fullName} · ${site.role}`,
      url: homeUrl,
      telephone: `+${whatsappNumber}`,
      address,
      areaServed: [site.city, site.stateName, 'Brasil'],
    },
  ],
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <Hero />

  {contributions && <ContributionGraph data={contributions} />}

  <Section
    id="trabalhos"
    number="01"
    label="Trabalhos"
    info={projectInfo}
    title="Trabalhos selecionados."
    lede="Sistemas e sites para clientes, propostas e produtos próprios."
  >
    <FilterPills label="Filtrar trabalhos" target="lista-trabalhos" options={projectFilters} />
    <div id="lista-trabalhos" class="project-grid" data-reveal>
      {projects.slice(0, ctaAfter).map((project, index) => <ProjectCard project={project} index={index + 1} />)}
      <ProjectCta />
      {projects.slice(ctaAfter).map((project, index) => <ProjectCard project={project} index={index + ctaAfter + 1} />)}
      <p class="empty mono" data-filter-empty hidden={projects.length > 0}>Nenhum projeto nesta categoria por enquanto.</p>
    </div>
  </Section>

  <Section
    id="como-funciona"
    number="02"
    label="Como funciona"
    info="Orçamento sem custo"
    title="Da primeira mensagem ao sistema no ar."
    lede="Você fala direto comigo, recebe a proposta por escrito e acompanha versões que já dá para testar."
  >
    <ProcessSteps steps={processSteps} guarantees={guarantees} />
  </Section>

  <Section
    id="servicos"
    number="03"
    label="Serviços"
    info="Para empresas"
    title="O que posso fazer pela sua empresa."
  >
    <ServicesGrid items={services} />
  </Section>

  <Section
    id="antes-e-depois"
    number="04"
    label="Antes e depois"
    info="Como era e como ficou"
    title="Antes e depois."
    lede="O que mudou na rotina de quem usa cada projeto."
  >
    <BeforeAfter items={beforeAfter} />
  </Section>

  <Section
    id="laboratorio"
    number="05"
    label="Laboratório"
    info="Uso próprio"
    title="Laboratório."
    lede="Projetos pessoais e ferramentas que fiz para uso próprio."
  >
    <LabList items={lab} />
  </Section>

  <Section
    id="componentes"
    number="06"
    label="Componentes"
    info="web-components"
    infoHref={componentsRepoUrl}
    title="Componentes."
    lede="Peças independentes de framework, retiradas deste site. Cada uma é um pacote próprio, com código aberto."
  >
    <ul class="component-grid" role="list" data-reveal>
      {
        homeComponents.map((component) => (
          <ComponentCard
            component={component}
            weeks={recentWeeks}
            total={recentStats.total}
            streak={recentStats.longestStreak}
            height={190}
          />
        ))
      }
    </ul>
    <a class="all-components mono" href="/componentes/">Ver todos os componentes</a>
  </Section>

  <Section id="sobre" number="07" label="Sobre" info="Quem escreve o código">
    <About headingId="sobre-titulo" />
  </Section>

  <Section
    id="stack"
    number="08"
    label="Stack"
    info="Só o que uso de verdade"
    title="Ferramentas."
    lede="As ferramentas por trás dos projetos desta página."
  >
    <StackList groups={stack} />
    <StackMarquee />
  </Section>

  <Contact />
</BaseLayout>

<style>
  .project-grid,
  .component-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .component-grid {
    margin-top: 0;
  }

  .empty {
    grid-column: 1 / -1;
    padding: 24px 0;
    font-size: 13px;
    color: var(--text-muted);
  }

  .empty[hidden] {
    display: none;
  }

  .all-components {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 12px;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 4px;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  .all-components:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  @media (max-width: 1000px) {
    .project-grid,
    .component-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .project-grid,
    .component-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
