---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import BaseLayout from '../layouts/BaseLayout.astro';
import GridRow from '../components/GridRow.astro';
import FilterPills from '../components/FilterPills.astro';
import PreviewCord from '../components/showcase/PreviewCord.astro';
import PreviewActivity from '../components/showcase/PreviewActivity.astro';
import PreviewGlass from '../components/showcase/PreviewGlass.astro';
import PreviewRing from '../components/showcase/PreviewRing.astro';
import PreviewSteps from '../components/showcase/PreviewSteps.astro';
import PreviewDots from '../components/showcase/PreviewDots.astro';
import { categoryLabel, componentCategories, componentUrl, components } from '../data/components';
import { getContributionStats, getContributions } from '../lib/github';
import { fullName } from '../config/site';

const published = components.filter((component) => component.status === 'publicado').length;
const upcoming = components.length - published;

const contributions = await getContributions();
const recentWeeks = contributions?.weeks.slice(-26) ?? [];
const recentStats = getContributionStats(recentWeeks);

const title = `Componentes · ${fullName}`;
const description =
  'Web components independentes de framework, retirados do portfólio de George Peixoto. Cada um é um pacote próprio, com código aberto.';
---

<BaseLayout title={title} description={description}>
  <section class="showcase" aria-labelledby="componentes-titulo">
    <GridRow>
      <p class="eyebrow mono">
        <span>web-components — vitrine</span>
        <span>{published} {published === 1 ? 'publicado' : 'publicados'} · {upcoming} em breve</span>
      </p>
    </GridRow>

    <GridRow>
      <div class="intro">
        <h1 id="componentes-titulo">Componentes.</h1>
        <p class="lede">
          Peças independentes de framework, retiradas do meu portfólio. Cada uma é um pacote próprio, funciona em qualquer
          site e tem o código aberto.
        </p>
      </div>
    </GridRow>

    <GridRow>
      <div class="filter-row">
        <FilterPills label="Filtrar componentes" target="lista-componentes" options={componentCategories} />
      </div>
    </GridRow>

    <GridRow>
      <ul id="lista-componentes" class="grid" role="list">
        {
          components.map((component) => (
            <li class="card" data-filter-item data-category={component.category}>
              <div class="preview" data-preview>
                {component.preview === 'pull-cord' && <PreviewCord />}
                {component.preview === 'github-activity' && (
                  <PreviewActivity weeks={recentWeeks} total={recentStats.total} streak={recentStats.longestStreak} />
                )}
                {component.preview === 'glass-nav' && <PreviewGlass />}
                {component.preview === 'scroll-ring' && <PreviewRing />}
                {component.preview === 'step-timeline' && <PreviewSteps />}
                {component.preview === 'dot-field' && <PreviewDots />}
              </div>
              <div class="head">
                <h2 class="tag-name mono">&lt;{component.tag}&gt;</h2>
                <span class:list={['status', 'mono', { published: component.status === 'publicado' }]}>
                  {component.status === 'publicado' ? 'publicado' : 'em breve'}
                </span>
              </div>
              <p class="description">{component.description}</p>
              <div class="foot">
                <span class="category mono">{categoryLabel(component.category)}</span>
                {component.status === 'publicado' ? (
                  <a class="docs" href={componentUrl(component)} target="_blank" rel="noopener">
                    Código e docs
                    <ArrowUpRight aria-hidden="true" />
                  </a>
                ) : (
                  <span class="soon">Em breve</span>
                )}
              </div>
            </li>
          ))
        }
        <li class="empty mono" data-filter-empty hidden>Nenhum componente nesta categoria por enquanto.</li>
      </ul>
    </GridRow>

    <GridRow>
      <p class="license mono">Código aberto sob licença MIT.</p>
    </GridRow>
  </section>
</BaseLayout>

<style>
  .showcase {
    padding-top: 96px;
  }

  .eyebrow {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 16px;
    padding: 12px 88px 12px 16px;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: end;
    gap: 16px 48px;
    padding: 40px 16px 32px;
  }

  h1 {
    font-size: clamp(40px, 6vw, 84px);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .lede {
    max-width: 46ch;
    font-size: 17px;
    color: var(--text-muted);
  }

  .filter-row {
    padding: 12px 16px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 12px;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    padding: 10px;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .card[hidden],
  .empty[hidden] {
    display: none;
  }

  .preview {
    position: relative;
    height: 210px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg);
    isolation: isolate;
  }

  :global(html.js [data-preview]:not([data-visible]) *) {
    animation-play-state: paused !important;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 12px;
    padding: 4px 4px 0;
  }

  .tag-name {
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .status {
    display: inline-flex;
    align-items: center;
    min-height: 22px;
    padding: 0 8px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-size: 11px;
    line-height: 1;
    color: var(--text-faint);
  }

  .published {
    border-color: color-mix(in oklab, var(--accent) 45%, transparent);
    background: color-mix(in oklab, var(--accent) 10%, transparent);
    color: var(--accent);
  }

  .description {
    flex: 1;
    padding: 0 4px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 12px;
    margin-top: 4px;
    padding: 10px 4px 2px;
    border-top: 1px solid var(--border);
  }

  .category {
    font-size: 12px;
    color: var(--text-faint);
  }

  .docs {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 32px;
    font-size: 14px;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.15s ease;
  }

  .docs:hover {
    text-decoration-color: currentColor;
  }

  .docs :global(svg) {
    width: 14px;
    height: 14px;
  }

  .soon {
    min-height: 32px;
    display: inline-flex;
    align-items: center;
    font-size: 14px;
    color: var(--text-faint);
  }

  .empty {
    grid-column: 1 / -1;
    padding: 24px 4px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .license {
    padding: 16px;
    font-size: 12px;
    color: var(--text-faint);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .intro {
      grid-template-columns: minmax(0, 1fr);
      padding: 28px 16px 24px;
    }
  }

  @media (max-width: 620px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  import { onPage } from '../scripts/page';

  onPage(() => {
    const previews = document.querySelectorAll<HTMLElement>('[data-preview]');
    if (!previews.length) return;

    if (!('IntersectionObserver' in window)) {
      previews.forEach((preview) => {
        preview.dataset.visible = '';
        preview.dataset.in = '';
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const preview = entry.target as HTMLElement;
          preview.toggleAttribute('data-visible', entry.isIntersecting);
          if (entry.isIntersecting && entry.intersectionRatio >= 0.35) preview.dataset.in = '';
        }
      },
      { threshold: [0, 0.35] },
    );
    previews.forEach((preview) => observer.observe(preview));
    return () => observer.disconnect();
  });
</script>
