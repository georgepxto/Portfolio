---
interface Props {
  label?: string;
}

const { label = '[PRINT DO PROJETO]' } = Astro.props;
---

<div class="placeholder mono" role="img" aria-label="Imagem do projeto ainda não disponível">
  <span aria-hidden="true">{label}</span>
</div>

<style>
  .placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: var(--surface);
    font-size: 12px;
    color: var(--text-faint);
    letter-spacing: 0.02em;
  }
</style>
