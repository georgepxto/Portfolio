---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import GridRow from './GridRow.astro';
import PullCord from './PullCord.astro';
import CordNote from './CordNote.astro';
import { emailUrl, githubUrl, site, whatsappUrl } from '../config/site';

const links = [
  { href: '/#trabalhos', label: 'Trabalhos', number: '01' },
  { href: '/#como-funciona', label: 'Como funciona', number: '02' },
  { href: '/#servicos', label: 'Serviços', number: '03' },
  { href: '/#componentes', label: 'Componentes', number: '06' },
  { href: '/#sobre', label: 'Sobre', number: '07' },
  { href: '/#contato', label: 'Contato', number: '09' },
];
---

<header class="site-header" data-site-header transition:persist="site-header">
  <div class="bar" data-site-bar>
    <a class="logo mono" href="/#topo" aria-label="George, início">george.dev<span aria-hidden="true">/</span><span class="logo-section" aria-live="polite" data-logo-section></span></a>
    <nav class="nav-inline" aria-label="Principal" data-nav-inline>
      <span class="nav-indicator" aria-hidden="true" data-nav-indicator></span>
      <ul role="list">
        {
          links.map((link) => (
            <li>
              <a href={link.href} data-nav-link>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="nav-cta" href="/#contato">
      Fale comigo
      <ArrowRight size={16} stroke-width={2} aria-hidden="true" />
    </a>
    <button
      class="menu-toggle"
      type="button"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="menu-celular"
      data-menu-toggle
    >
      <span class="menu-label mono" aria-hidden="true">
        <span class="label-open">Menu</span>
        <span class="label-close">Fechar</span>
      </span>
      <span class="menu-icon" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>
    <PullCord />
  </div>

  <div id="menu-celular" class="menu-panel" data-menu-panel data-lenis-prevent>
    <nav aria-label="Principal">
      <ul role="list">
        {
          links.map((link, index) => (
            <GridRow as="li" class="menu-row" style={`--i: ${index}`}>
              <a class="menu-link" href={link.href}>
                <span class="menu-number mono" aria-hidden="true">
                  {link.number}
                </span>
                <span class="menu-name">{link.label}</span>
              </a>
            </GridRow>
          ))
        }
      </ul>
    </nav>

    <GridRow class="menu-footer">
      <div class="menu-footer-inner">
        {
          site.available && (
            <p class="menu-status mono">
              <span class="menu-status-dot" aria-hidden="true" />
              Disponível para novos projetos
            </p>
          )
        }
        <a class="button button-primary menu-cta" href={whatsappUrl} target="_blank" rel="noopener">
          Pedir orçamento no WhatsApp
          <ArrowUpRight aria-hidden="true" />
        </a>
        <p class="menu-meta mono">
          <a href={emailUrl}>{site.email}</a>
          <a href={githubUrl} target="_blank" rel="noopener">
            GitHub
            <ArrowUpRight aria-hidden="true" />
          </a>
        </p>
      </div>
    </GridRow>
  </div>
</header>

<CordNote />

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    height: 0;
  }

  .bar {
    position: relative;
    top: var(--nav-top);
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 4px;
    width: min(1148px, 100%);
    min-height: 58px;
    margin: 0 auto;
    padding: 7px 8px 7px 24px;
    border: 1px solid color-mix(in oklab, var(--text) 12%, transparent);
    border-radius: 30px;
    background: color-mix(in oklab, var(--bg) 58%, transparent);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    backdrop-filter: blur(18px) saturate(160%);
    box-shadow:
      0 12px 32px -8px rgba(0, 0, 0, 0.28),
      inset 0 1px color-mix(in oklab, var(--text) 7%, transparent);
  }

  .logo {
    margin-right: auto;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
  }

  .logo span {
    color: var(--accent);
  }

  .logo .logo-section {
    display: none;
    color: var(--text-muted);
  }

  .nav-inline {
    position: relative;
    isolation: isolate;
  }

  .nav-indicator {
    position: absolute;
    top: 50%;
    left: 0;
    z-index: -1;
    width: 0;
    height: 34px;
    margin-top: -17px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--text) 9%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--text) 10%, transparent);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1),
      width 0.55s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.3s ease;
  }

  .nav-indicator.is-visible {
    opacity: 1;
  }

  .nav-inline ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 4px;
  }

  .nav-inline a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    min-width: 44px;
    padding: 0 8px;
    font-size: 14px;
    color: var(--text-muted);
    transition: color 0.15s ease;
  }

  .nav-inline a:hover {
    color: var(--text);
  }

  .nav-inline a[aria-current] {
    color: var(--text);
    transition: color 0.3s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-indicator {
      transition: opacity 0.3s ease;
    }
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-left: 12px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    transition: filter 0.2s ease;
  }

  .nav-cta:hover {
    filter: brightness(1.08);
  }

  .nav-cta :global(svg) {
    flex: none;
    width: 16px;
    height: 16px;
  }

  .menu-toggle,
  .menu-panel {
    display: none;
  }

  @media (max-width: 760px) {
    .nav-cta {
      display: none;
    }
  }

  @media (max-width: 1000px) {
    .bar {
      flex-wrap: nowrap;
      gap: 0;
    }

    .nav-inline {
      display: none;
    }

    .logo {
      min-width: 0;
      white-space: nowrap;
    }

    .logo .logo-section {
      display: inline-block;
      overflow: hidden;
      text-overflow: ellipsis;
      letter-spacing: -0.02em;
    }

    .menu-toggle {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      min-height: 44px;
      padding: 0 10px;
      border: 0;
      background: none;
      color: var(--text);
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }

    .menu-label {
      display: grid;
      width: 52px;
      font-size: 13px;
      line-height: 1;
      text-align: right;
    }

    .menu-label > span {
      grid-area: 1 / 1;
    }

    .label-close {
      opacity: 0;
    }

    .menu-toggle[aria-expanded='true'] .label-open,
    .menu-toggle.is-animated[aria-expanded='false'] .label-close {
      animation:
        label-fade-out 250ms ease both,
        label-rise-out 300ms cubic-bezier(0.7, 0, 0.2, 1) both;
    }

    .menu-toggle[aria-expanded='true'] .label-close,
    .menu-toggle.is-animated[aria-expanded='false'] .label-open {
      animation:
        label-fade-in 250ms ease both,
        label-rise-in 300ms cubic-bezier(0.7, 0, 0.2, 1) both;
    }

    .menu-icon {
      position: relative;
      flex: none;
      width: 18px;
      height: 12px;
    }

    .menu-icon > span {
      position: absolute;
      left: 0;
      width: 100%;
      height: 1.5px;
      background: currentColor;
      transition:
        top 350ms cubic-bezier(0.7, 0, 0.2, 1),
        transform 350ms cubic-bezier(0.7, 0, 0.2, 1);
    }

    .menu-icon > span:first-child {
      top: 2px;
    }

    .menu-icon > span:last-child {
      top: 8.5px;
    }

    .menu-toggle[aria-expanded='true'] .menu-icon > span {
      top: 5.25px;
    }

    .menu-toggle[aria-expanded='true'] .menu-icon > span:first-child {
      transform: rotate(45deg);
    }

    .menu-toggle[aria-expanded='true'] .menu-icon > span:last-child {
      transform: rotate(-45deg);
    }

    .menu-panel {
      position: absolute;
      top: 0;
      left: calc(50% - 50cqw);
      z-index: 2;
      display: flex;
      flex-direction: column;
      width: 100cqw;
      height: 100vh;
      height: 100dvh;
      padding-top: calc(var(--nav-top) * 2 + var(--nav-height));
      overflow-y: auto;
      overscroll-behavior: contain;
      background: var(--bg);
      clip-path: inset(0 0 100% 0);
      visibility: hidden;
      pointer-events: none;
      transition:
        clip-path 550ms cubic-bezier(0.7, 0, 0.2, 1),
        visibility 550ms;
    }

    .menu-panel.is-open {
      clip-path: inset(0 0 0 0);
      visibility: visible;
      pointer-events: auto;
    }

    .menu-panel nav {
      border-top: 1px solid var(--border);
    }

    .menu-panel ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .menu-link {
      display: flex;
      align-items: baseline;
      min-height: 64px;
      padding: 16px var(--pad-x);
      border-bottom: 1px solid var(--border);
      color: var(--text);
      opacity: 0;
      transform: translateY(-10px);
      transition:
        opacity 0s 550ms,
        transform 0s 550ms;
    }

    .menu-panel.is-open .menu-link {
      opacity: 1;
      transform: none;
      transition:
        opacity 400ms ease,
        transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1);
      transition-delay: calc(120ms + var(--i) * 45ms);
    }

    .menu-number {
      flex: none;
      width: 22px;
      font-size: 12px;
      color: var(--accent);
    }

    .menu-name {
      font-size: 28px;
      font-weight: 600;
      line-height: 1.15;
      letter-spacing: -0.025em;
    }

    :global(.menu-footer) {
      margin-top: auto;
      border-top: 1px solid var(--border);
      --row-border: 0;
    }

    .menu-footer-inner {
      display: flex;
      flex-direction: column;
      gap: 16px;
      padding: 16px var(--pad-x) 28px;
      opacity: 0;
      transform: translateY(-10px);
      transition:
        opacity 0s 550ms,
        transform 0s 550ms;
    }

    .menu-panel.is-open .menu-footer-inner {
      opacity: 1;
      transform: none;
      transition:
        opacity 400ms ease 320ms,
        transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1) 320ms;
    }

    .menu-status {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      color: var(--accent);
    }

    .menu-status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow:
        0 0 2px var(--accent),
        0 0 8px color-mix(in oklab, var(--accent) 70%, transparent);
    }

    .menu-cta {
      width: 100%;
      min-height: 52px;
    }

    .menu-meta {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      font-size: 12px;
      color: var(--text-faint);
    }

    .menu-meta a {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      min-width: 0;
      transition: color 0.15s ease;
    }

    .menu-meta a:hover {
      color: var(--text);
    }

    .menu-meta :global(svg) {
      width: 12px;
      height: 12px;
    }

    .site-header.is-menu-open :global(.pull-cord) {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    :global(html.is-menu-open) {
      overflow: hidden;
    }

    :global(html:not(.js)) .site-header {
      position: static;
      height: auto;
    }

    :global(html:not(.js)) .menu-toggle {
      display: none;
    }

    :global(html:not(.js)) .menu-panel {
      position: static;
      width: auto;
      height: auto;
      margin-inline: 0;
      padding-top: calc(var(--nav-top) * 2);
      clip-path: none;
      visibility: visible;
      pointer-events: auto;
    }

    :global(html:not(.js)) .menu-link,
    :global(html:not(.js)) .menu-footer-inner {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 1000px) and (prefers-reduced-motion: reduce) {
    .menu-panel,
    .menu-panel.is-open,
    .menu-link,
    .menu-panel.is-open .menu-link,
    .menu-footer-inner,
    .menu-panel.is-open .menu-footer-inner,
    .menu-icon > span {
      transition: none;
    }

    .menu-link,
    .menu-footer-inner {
      opacity: 1;
      transform: none;
    }

    .menu-toggle .menu-label > span {
      animation: none;
    }

    .menu-toggle[aria-expanded='true'] .label-open,
    .menu-toggle[aria-expanded='false'] .label-close {
      opacity: 0;
    }

    .menu-toggle[aria-expanded='true'] .label-close,
    .menu-toggle[aria-expanded='false'] .label-open {
      opacity: 1;
    }
  }

  @keyframes label-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes label-fade-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes label-rise-in {
    from {
      transform: translateY(8px);
    }
    to {
      transform: none;
    }
  }

  @keyframes label-rise-out {
    from {
      transform: none;
    }
    to {
      transform: translateY(-8px);
    }
  }
</style>

<script>
  import { onElement, onPage } from '../scripts/page';
  import { getLenis } from '../scripts/smooth-scroll';

  const root = document.documentElement;

  onElement<HTMLElement>('[data-site-header]', (header, signal) => {
    const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const panel = header.querySelector<HTMLElement>('[data-menu-panel]');
    const bar = header.querySelector<HTMLElement>('[data-site-bar]');
    if (!toggle || !panel || !bar) return;

    const barSize = new ResizeObserver(() => root.style.setProperty('--nav-height', `${bar.offsetHeight}px`));
    barSize.observe(bar);

    const desktop = matchMedia('(min-width: 1001px)');
    const siblings = () =>
      Array.from(header.parentElement?.children ?? []).filter(
        (element): element is HTMLElement => element !== header && element instanceof HTMLElement,
      );

    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    const setOpen = (open: boolean) => {
      if (open === isOpen()) return;
      toggle.classList.add('is-animated');
      panel.classList.toggle('is-open', open);
      header.classList.toggle('is-menu-open', open);
      root.classList.toggle('is-menu-open', open);
      if (open) getLenis()?.stop();
      else getLenis()?.start();
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
      siblings().forEach((element) => {
        element.inert = open;
      });
    };

    toggle.addEventListener('click', () => setOpen(!isOpen()), { signal });

    panel.addEventListener(
      'click',
      (event) => {
        if ((event.target as HTMLElement).closest('a')) setOpen(false);
      },
      { signal },
    );

    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key !== 'Escape' || !isOpen()) return;
        setOpen(false);
        toggle.focus();
      },
      { signal },
    );

    document.addEventListener('astro:before-swap', () => setOpen(false), { signal });

    desktop.addEventListener(
      'change',
      (event) => {
        if (event.matches) setOpen(false);
      },
      { signal },
    );

    return () => barSize.disconnect();
  });

  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

  onPage((signal) => {
    const nav = document.querySelector<HTMLElement>('[data-nav-inline]');
    const indicator = document.querySelector<HTMLElement>('[data-nav-indicator]');
    const sectionLabel = document.querySelector<HTMLElement>('[data-logo-section]');
    if (!nav || !indicator || !sectionLabel) return;

    const home = location.pathname === '/';
    const targets = Array.from(nav.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')).flatMap((link) => {
      const target = home ? document.getElementById(decodeURIComponent(link.hash.slice(1))) : null;
      return target ? [{ link, target }] : [];
    });
    const sections = home ? Array.from(document.querySelectorAll<HTMLElement>('#conteudo section[id]')) : [];

    let active: HTMLAnchorElement | null = null;
    let section = sectionLabel.textContent ?? '';
    let frame = 0;

    const place = (snap: boolean) => {
      nav.querySelectorAll('[data-nav-link]').forEach((link) => {
        if (link === active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });

      if (!active || !nav.offsetWidth) {
        indicator.classList.remove('is-visible');
        return;
      }

      const instant = snap || !indicator.classList.contains('is-visible');
      const left = active.getBoundingClientRect().left - nav.getBoundingClientRect().left;
      if (instant) indicator.style.transitionProperty = 'opacity';
      indicator.style.transform = `translateX(${left}px)`;
      indicator.style.width = `${active.offsetWidth}px`;
      if (instant) void indicator.offsetWidth;
      indicator.classList.add('is-visible');
      if (instant) indicator.style.transitionProperty = '';
    };

    const showSection = (id: string) => {
      if (id === section) return;
      section = id;
      sectionLabel.textContent = id;
      if (!id || reducedMotion.matches) return;
      sectionLabel.animate(
        [
          { opacity: 0, transform: 'translateY(6px)' },
          { opacity: 1, transform: 'none' },
        ],
        { duration: 320, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' },
      );
    };

    const update = (snap = false) => {
      frame = 0;
      const line = innerHeight * 0.4;
      const above = (element: HTMLElement) => element.getBoundingClientRect().top < line;

      const next = targets.findLast(({ target }) => above(target))?.link ?? null;
      if (next !== active || snap) {
        active = next;
        place(snap);
      }

      const current = sections.findLast(above)?.id ?? '';
      showSection(current === 'topo' ? '' : current);
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(() => update());
    };

    const resnap = () => {
      cancelAnimationFrame(frame);
      update(true);
    };

    addEventListener('scroll', schedule, { passive: true, signal });
    addEventListener('resize', resnap, { signal });
    const navSize = new ResizeObserver(resnap);
    navSize.observe(nav);
    document.fonts?.ready.then(() => {
      if (!signal.aborted) resnap();
    });

    update(true);

    return () => {
      cancelAnimationFrame(frame);
      navSize.disconnect();
    };
  });
</script>
