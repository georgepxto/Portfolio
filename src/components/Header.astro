---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import GridRow from './GridRow.astro';
import PullCord from './PullCord.astro';
import CordNote from './CordNote.astro';
import { emailUrl, githubUrl, site, whatsappUrl } from '../config/site';

const links = [
  { href: '/#trabalhos', label: 'Trabalhos', number: '01' },
  { href: '/#como-funciona', label: 'Como funciona', number: '02' },
  { href: '/#servicos', label: 'Serviços', number: '03' },
  { href: '/#sobre', label: 'Sobre', number: '06' },
  { href: '/#contato', label: 'Contato', number: '—' },
];
---

<header class="site-header" data-site-header transition:persist="site-header">
  <GridRow class="site-header-row">
    <div class="bar">
      <a class="logo mono" href="/#topo" aria-label="George, início">george.dev<span aria-hidden="true">/</span></a>
      <nav class="nav-inline" aria-label="Principal">
        <ul role="list">
          {
            links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <button
        class="menu-toggle"
        type="button"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="menu-celular"
        data-menu-toggle
      >
        <span class="menu-label mono" aria-hidden="true">
          <span class="label-open">Menu</span>
          <span class="label-close">Fechar</span>
        </span>
        <span class="menu-icon" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </GridRow>

  <div id="menu-celular" class="menu-panel" data-menu-panel>
    <nav aria-label="Principal">
      <ul role="list">
        {
          links.map((link, index) => (
            <GridRow as="li" class="menu-row" style={`--i: ${index}`}>
              <a class="menu-link" href={link.href}>
                <span class="menu-number mono" aria-hidden="true">
                  {link.number}
                </span>
                <span class="menu-name">{link.label}</span>
              </a>
            </GridRow>
          ))
        }
      </ul>
    </nav>

    <GridRow class="menu-footer">
      <div class="menu-footer-inner">
        {
          site.available && (
            <p class="menu-status mono">
              <span class="menu-status-dot" aria-hidden="true" />
              Disponível para novos projetos
            </p>
          )
        }
        <a class="button button-primary menu-cta" href={whatsappUrl} target="_blank" rel="noopener">
          Pedir orçamento no WhatsApp
          <ArrowUpRight aria-hidden="true" />
        </a>
        <p class="menu-meta mono">
          <a href={emailUrl}>{site.email}</a>
          <a href={githubUrl} target="_blank" rel="noopener">
            GitHub
            <ArrowUpRight aria-hidden="true" />
          </a>
        </p>
      </div>
    </GridRow>
  </div>

  <PullCord />
</header>

<CordNote />

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
  }

  :global(.site-header-row) {
    background: var(--bg);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0 4px;
    min-height: var(--header-height);
    padding: 0 var(--gutter);
  }

  .logo {
    margin-right: auto;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
  }

  .logo span {
    color: var(--accent);
  }

  .nav-inline ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 4px;
    margin: 0 -8px 0 0;
  }

  .nav-inline a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    min-width: 44px;
    padding: 0 8px;
    font-size: 14px;
    color: var(--text-muted);
    transition: color 0.15s ease;
  }

  .nav-inline a:hover {
    color: var(--text);
  }

  .menu-toggle,
  .menu-panel {
    display: none;
  }

  @media (max-width: 640px) {
    .site-header {
      --cord-right: 3px;
    }

    .bar {
      gap: 0;
      padding: 0 6px 0 12px;
    }

    .nav-inline {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      min-height: 44px;
      padding: 0 10px;
      border: 0;
      background: none;
      color: var(--text);
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }

    .menu-label {
      display: grid;
      width: 52px;
      font-size: 13px;
      line-height: 1;
      text-align: right;
    }

    .menu-label > span {
      grid-area: 1 / 1;
    }

    .label-close {
      opacity: 0;
    }

    .menu-toggle[aria-expanded='true'] .label-open,
    .menu-toggle.is-animated[aria-expanded='false'] .label-close {
      animation:
        label-fade-out 250ms ease both,
        label-rise-out 300ms cubic-bezier(0.7, 0, 0.2, 1) both;
    }

    .menu-toggle[aria-expanded='true'] .label-close,
    .menu-toggle.is-animated[aria-expanded='false'] .label-open {
      animation:
        label-fade-in 250ms ease both,
        label-rise-in 300ms cubic-bezier(0.7, 0, 0.2, 1) both;
    }

    .menu-icon {
      position: relative;
      flex: none;
      width: 18px;
      height: 12px;
    }

    .menu-icon > span {
      position: absolute;
      left: 0;
      width: 100%;
      height: 1.5px;
      background: currentColor;
      transition:
        top 350ms cubic-bezier(0.7, 0, 0.2, 1),
        transform 350ms cubic-bezier(0.7, 0, 0.2, 1);
    }

    .menu-icon > span:first-child {
      top: 2px;
    }

    .menu-icon > span:last-child {
      top: 8.5px;
    }

    .menu-toggle[aria-expanded='true'] .menu-icon > span {
      top: 5.25px;
    }

    .menu-toggle[aria-expanded='true'] .menu-icon > span:first-child {
      transform: rotate(45deg);
    }

    .menu-toggle[aria-expanded='true'] .menu-icon > span:last-child {
      transform: rotate(-45deg);
    }

    .menu-panel {
      position: absolute;
      top: 100%;
      left: calc(50% - 50cqw);
      z-index: 2;
      display: flex;
      flex-direction: column;
      width: 100cqw;
      height: calc(100vh - var(--header-height) - 1px);
      height: calc(100dvh - var(--header-height) - 1px);
      overflow-y: auto;
      overscroll-behavior: contain;
      background: var(--bg);
      clip-path: inset(0 0 100% 0);
      visibility: hidden;
      pointer-events: none;
      transition:
        clip-path 550ms cubic-bezier(0.7, 0, 0.2, 1),
        visibility 550ms;
    }

    .menu-panel.is-open {
      clip-path: inset(0 0 0 0);
      visibility: visible;
      pointer-events: auto;
    }

    .menu-panel ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .menu-link {
      display: flex;
      align-items: baseline;
      min-height: 64px;
      padding: 16px;
      color: var(--text);
      opacity: 0;
      transform: translateY(-10px);
      transition:
        opacity 0s 550ms,
        transform 0s 550ms;
    }

    .menu-panel.is-open .menu-link {
      opacity: 1;
      transform: none;
      transition:
        opacity 400ms ease,
        transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1);
      transition-delay: calc(120ms + var(--i) * 45ms);
    }

    .menu-number {
      flex: none;
      width: 22px;
      font-size: 12px;
      color: var(--accent);
    }

    .menu-name {
      font-size: 28px;
      font-weight: 600;
      line-height: 1.15;
      letter-spacing: -0.025em;
    }

    :global(.menu-footer) {
      margin-top: auto;
      border-top: 1px solid var(--border);
      --row-border: 0;
    }

    .menu-footer-inner {
      display: flex;
      flex-direction: column;
      gap: 16px;
      padding: 16px 16px 28px;
      opacity: 0;
      transform: translateY(-10px);
      transition:
        opacity 0s 550ms,
        transform 0s 550ms;
    }

    .menu-panel.is-open .menu-footer-inner {
      opacity: 1;
      transform: none;
      transition:
        opacity 400ms ease 320ms,
        transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1) 320ms;
    }

    .menu-status {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      color: var(--accent);
    }

    .menu-status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow:
        0 0 2px var(--accent),
        0 0 8px color-mix(in oklab, var(--accent) 70%, transparent);
    }

    .menu-cta {
      width: 100%;
      min-height: 52px;
    }

    .menu-meta {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      font-size: 12px;
      color: var(--text-faint);
    }

    .menu-meta a {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      min-width: 0;
      transition: color 0.15s ease;
    }

    .menu-meta a:hover {
      color: var(--text);
    }

    .menu-meta :global(svg) {
      width: 12px;
      height: 12px;
    }

    .site-header.is-menu-open :global(.pull-cord) {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    :global(html.is-menu-open) {
      overflow: hidden;
    }

    :global(html:not(.js)) .site-header {
      position: static;
    }

    :global(html:not(.js)) .menu-toggle {
      display: none;
    }

    :global(html:not(.js)) .menu-panel {
      position: static;
      width: auto;
      height: auto;
      margin-inline: 0;
      clip-path: none;
      visibility: visible;
      pointer-events: auto;
    }

    :global(html:not(.js)) .menu-link,
    :global(html:not(.js)) .menu-footer-inner {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 640px) and (prefers-reduced-motion: reduce) {
    .menu-panel,
    .menu-panel.is-open,
    .menu-link,
    .menu-panel.is-open .menu-link,
    .menu-footer-inner,
    .menu-panel.is-open .menu-footer-inner,
    .menu-icon > span {
      transition: none;
    }

    .menu-link,
    .menu-footer-inner {
      opacity: 1;
      transform: none;
    }

    .menu-toggle .menu-label > span {
      animation: none;
    }

    .menu-toggle[aria-expanded='true'] .label-open,
    .menu-toggle[aria-expanded='false'] .label-close {
      opacity: 0;
    }

    .menu-toggle[aria-expanded='true'] .label-close,
    .menu-toggle[aria-expanded='false'] .label-open {
      opacity: 1;
    }
  }

  @keyframes label-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes label-fade-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes label-rise-in {
    from {
      transform: translateY(8px);
    }
    to {
      transform: none;
    }
  }

  @keyframes label-rise-out {
    from {
      transform: none;
    }
    to {
      transform: translateY(-8px);
    }
  }
</style>

<script>
  import { onElement } from '../scripts/page';

  const root = document.documentElement;

  onElement<HTMLElement>('[data-site-header]', (header, signal) => {
    const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const panel = header.querySelector<HTMLElement>('[data-menu-panel]');
    if (!toggle || !panel) return;

    const desktop = matchMedia('(min-width: 641px)');
    const siblings = () =>
      Array.from(header.parentElement?.children ?? []).filter(
        (element): element is HTMLElement => element !== header && element instanceof HTMLElement,
      );

    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    const setOpen = (open: boolean) => {
      if (open === isOpen()) return;
      toggle.classList.add('is-animated');
      panel.classList.toggle('is-open', open);
      header.classList.toggle('is-menu-open', open);
      root.classList.toggle('is-menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
      siblings().forEach((element) => {
        element.inert = open;
      });
    };

    toggle.addEventListener('click', () => setOpen(!isOpen()), { signal });

    panel.addEventListener(
      'click',
      (event) => {
        if ((event.target as HTMLElement).closest('a')) setOpen(false);
      },
      { signal },
    );

    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key !== 'Escape' || !isOpen()) return;
        setOpen(false);
        toggle.focus();
      },
      { signal },
    );

    document.addEventListener('astro:before-swap', () => setOpen(false), { signal });

    desktop.addEventListener(
      'change',
      (event) => {
        if (event.matches) setOpen(false);
      },
      { signal },
    );
  });
</script>
