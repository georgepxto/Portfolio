---
import type { ContributionWeek } from '../../lib/github';

interface Props {
  weeks: ContributionWeek[];
  total: number;
  streak: number;
}

const { weeks, total, streak } = Astro.props;
const number = new Intl.NumberFormat('pt-BR');
const label = `${number.format(total)} contribuições no GitHub nas últimas ${weeks.length} semanas`;
---

<div class="pv-activity">
  <div class="cells" style={`--weeks: ${Math.max(1, weeks.length)}`} role="img" aria-label={label}>
    {
      weeks.flatMap((week, column) =>
        week.days.map((day) => (
          <span
            class="cell"
            data-level={day.level}
            style={`grid-column: ${column + 1}; grid-row: ${day.weekday + 1}; --c: ${column}`}
          />
        )),
      )
    }
  </div>
  <dl class="numbers">
    <div>
      <dt class="mono">contribuições</dt>
      <dd>{number.format(total)}</dd>
    </div>
    <div>
      <dt class="mono">maior sequência</dt>
      <dd>{streak} {streak === 1 ? 'dia' : 'dias'}</dd>
    </div>
  </dl>
</div>

<style>
  .pv-activity {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    padding: 18px;
  }

  .cells {
    display: grid;
    grid-template-columns: repeat(var(--weeks), minmax(0, 1fr));
    grid-template-rows: repeat(7, auto);
    gap: 3px;
  }

  .cell {
    aspect-ratio: 1;
    border-radius: 2px;
    background: var(--contrib-0);
  }

  .cell[data-level='1'] {
    background: var(--contrib-1);
  }

  .cell[data-level='2'] {
    background: var(--contrib-2);
  }

  .cell[data-level='3'] {
    background: var(--contrib-3);
  }

  .cell[data-level='4'] {
    background: var(--contrib-4);
  }

  .numbers {
    display: flex;
    gap: 28px;
  }

  dt {
    font-size: 11px;
    color: var(--text-faint);
  }

  dd {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js [data-preview]:not([data-in])) .cell {
      opacity: 0;
    }

    :global([data-preview][data-in]) .cell {
      animation: pv-pop 0.42s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--c) * 32ms) both;
    }
  }

  @keyframes pv-pop {
    from {
      opacity: 0;
      transform: scale(0.3);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
