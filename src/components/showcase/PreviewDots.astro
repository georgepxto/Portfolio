---
import DotField from '../DotField.astro';
---

<div class="pv-dots">
  <DotField gap={18} radius={90} grow={3} avoid=".pv-dots .hint" />
  <p class="hint mono" aria-hidden="true">mova o cursor</p>
</div>

<style>
  .pv-dots {
    --dot-color: color-mix(in oklab, var(--text) 22%, transparent);
    position: absolute;
    inset: 0;
    display: grid;
    place-items: end start;
  }

  .hint {
    position: relative;
    padding: 12px 14px;
    font-size: 11px;
    color: var(--text-faint);
  }
</style>
