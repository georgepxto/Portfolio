---
import ArrowUp from '@lucide/astro/icons/arrow-up';
---

<button class="back-to-top" type="button" aria-label="Voltar ao topo" tabindex="-1" data-back-to-top>
  <svg class="ring" viewBox="0 0 48 48" aria-hidden="true">
    <circle cx="24" cy="24" r="22.5" data-back-to-top-ring></circle>
  </svg>
  <ArrowUp class="arrow" aria-hidden="true" />
</button>

<style>
  .back-to-top {
    --offset: clamp(16px, 2.5vw, 28px);
    position: fixed;
    right: var(--offset);
    bottom: calc(var(--offset) + env(safe-area-inset-bottom));
    z-index: 15;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.22);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px) scale(0.9);
    pointer-events: none;
    transition:
      opacity 300ms ease,
      transform 400ms cubic-bezier(0.2, 0.7, 0.2, 1),
      visibility 300ms,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
  }

  :global(html.is-menu-open) .back-to-top {
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px) scale(0.9);
    pointer-events: none;
  }

  .back-to-top:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .back-to-top :global(.arrow) {
    width: 18px;
    height: 18px;
  }

  .ring {
    position: absolute;
    inset: -1px;
    width: 48px;
    height: 48px;
    transform: rotate(-90deg);
    pointer-events: none;
  }

  .ring circle {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-dasharray: 141.37;
    stroke-dashoffset: 141.37;
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top,
    .back-to-top.is-visible {
      transform: none;
      transition:
        opacity 300ms ease,
        visibility 300ms,
        border-color 0.15s ease,
        color 0.15s ease;
    }
  }
</style>

<script>
  const CIRCUMFERENCE = 141.37;

  const button = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
  const ring = button?.querySelector<SVGCircleElement>('[data-back-to-top-ring]');

  if (button && ring) {
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;
    let visible = false;

    const update = () => {
      frame = 0;
      const max = document.documentElement.scrollHeight - innerHeight;
      const progress = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
      ring.style.strokeDashoffset = String(CIRCUMFERENCE * (1 - progress));

      const shouldShow = scrollY > innerHeight * 0.6;
      if (shouldShow === visible) return;
      visible = shouldShow;
      button.classList.toggle('is-visible', visible);
      button.tabIndex = visible ? 0 : -1;
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule, { passive: true });

    button.addEventListener('click', () => {
      scrollTo({ top: 0, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
      document.querySelector<HTMLAnchorElement>('[data-site-header] .logo')?.focus({ preventScroll: true });
    });

    update();
  }
</script>
