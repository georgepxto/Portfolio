---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Section from './Section.astro';
import GridRow from './GridRow.astro';
import { getContributionStats, type Contributions, type ContributionWeek } from '../lib/github';
import { githubUrl, site } from '../config/site';

interface Props {
  data: Contributions;
  dimension?: boolean;
}

const { data, dimension = false } = Astro.props;
const { weeks } = data;

const monthNames = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
const weekdayNames = ['domingo', 'segunda-feira', 'terça-feira', 'quarta-feira', 'quinta-feira', 'sexta-feira', 'sábado'];
const minLabelGap = 3;

const toDate = (value: string) => new Date(`${value}T00:00:00Z`);
const monthOf = (value: string) => toDate(value).getUTCMonth();

const longDate = new Intl.DateTimeFormat('pt-BR', { dateStyle: 'long', timeZone: 'UTC' });
const shortDate = new Intl.DateTimeFormat('pt-BR', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
const number = new Intl.NumberFormat('pt-BR');

const formatShort = (value: string) =>
  shortDate
    .formatToParts(toDate(value))
    .filter((part) => part.type !== 'literal')
    .map((part) => part.value.replace('.', ''))
    .join(' ');

const plural = (count: number) => `${number.format(count)} ${count === 1 ? 'contribuição' : 'contribuições'}`;

const describeDay = (count: number, date: string) => {
  const when = longDate.format(toDate(date));
  return count === 0 ? `Nenhuma contribuição em ${when}` : `${plural(count)} em ${when}`;
};

type MonthLabel = { column: number; month: number };

const monthLabels = (range: ContributionWeek[]) => {
  const starts = range.flatMap((week, column) => {
    const first = week.days.find((day) => day.date.endsWith('-01'));
    return first ? [{ column, month: monthOf(first.date) }] : [];
  });

  if (!starts.length || starts[0].column >= minLabelGap) {
    if (starts[0]?.column !== 0) starts.unshift({ column: 0, month: monthOf(range[0].days[0].date) });
  }

  return starts.reduce<MonthLabel[]>((kept, label) => {
    const previous = kept[kept.length - 1];
    if (!previous || label.column - previous.column >= minLabelGap) kept.push(label);
    return kept;
  }, []);
};

const split = Math.ceil(weeks.length / 2);
const halves = [weeks.slice(0, split), weeks.slice(split)].map((range) => ({
  weeks: range,
  labels: monthLabels(range),
}));
const labels = monthLabels(weeks);

const firstDay = weeks[0].days[0];
const lastWeek = weeks[weeks.length - 1];
const lastDay = lastWeek.days[lastWeek.days.length - 1];

const stats = getContributionStats(weeks);
const statItems = [
  { label: 'Contribuições', value: number.format(stats.total), count: stats.total },
  {
    label: 'Maior sequência',
    value: `${number.format(stats.longestStreak)} ${stats.longestStreak === 1 ? 'dia' : 'dias'}`,
    count: stats.longestStreak,
    unitOne: 'dia',
    unitOther: 'dias',
  },
  { label: 'Dia mais ativo', value: stats.busiestWeekday === null ? '—' : weekdayNames[stats.busiestWeekday] },
];

const summary = `${plural(stats.total)} no GitHub nos últimos 12 meses`;
---

<Section
  id="atividade"
  dimension={dimension}
  number="GitHub"
  title="Atividade"
  subtitle="Commits e revisões dos últimos 12 meses, atualizados todo dia."
>
  <a slot="aside" class="profile-link mono" href={githubUrl} target="_blank" rel="noopener">
    {site.github}
    <ArrowUpRight aria-hidden="true" />
  </a>

  <GridRow>
    <dl class="stats" data-reveal>
      {
        statItems.map((item) => (
          <div class="stat">
            <dt class="mono">{item.label}</dt>
            <dd data-count={item.count} data-unit-one={item.unitOne} data-unit-other={item.unitOther}>
              {item.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </GridRow>

  <GridRow>
    <div class="activity" style={`--weeks: ${weeks.length}; --split: ${split}`}>
      <div class="canvas" role="img" aria-label={summary} data-contrib-wave>
        <div class="months months-full" aria-hidden="true">
          {labels.map((label) => <span style={`grid-column: ${label.column + 1}`}>{monthNames[label.month]}</span>)}
        </div>
        {
          halves.map((half, halfIndex) => (
            <div class="half" style={`--span: ${half.weeks.length}`}>
              <div class="months months-half" aria-hidden="true">
                {half.labels.map((label) => (
                  <span style={`grid-column: ${label.column + 1}`}>{monthNames[label.month]}</span>
                ))}
              </div>
              <div class="grid">
                {half.weeks.flatMap((week, column) =>
                  week.days.map((day, index) => (
                    <span
                      class="cell"
                      data-level={day.level}
                      title={describeDay(day.count, day.date)}
                      aria-hidden="true"
                      style={
                        halfIndex === 0 && column === 0 && index === 0 && firstDay.weekday > 0
                          ? `grid-row-start: ${firstDay.weekday + 1}`
                          : undefined
                      }
                    />
                  )),
                )}
              </div>
            </div>
          ))
        }
      </div>

      <div class="meta">
        <p class="caption">
          {formatShort(firstDay.date)} a {formatShort(lastDay.date)} ·{' '}
          <span class="source">Fonte: <a href={githubUrl} target="_blank" rel="noopener">GitHub</a></span>
        </p>
        <div class="legend" aria-hidden="true">
          <span>Menos</span>
          <span class="swatches">
            {[0, 1, 2, 3, 4].map((level) => <span class="cell" data-level={level} />)}
          </span>
          <span>Mais</span>
        </div>
      </div>
    </div>
  </GridRow>
</Section>

<style>
  .profile-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 4px;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  .profile-link:hover {
    color: var(--text);
    text-decoration-color: currentColor;
  }

  .profile-link :global(svg) {
    width: 14px;
    height: 14px;
    flex: none;
  }

  .activity {
    --cell-gap: 3px;
    --columns: repeat(var(--weeks), minmax(0, 1fr));
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 16px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .stat {
    padding: 14px 16px;
    min-width: 0;
  }

  .stat + .stat {
    border-left: 1px solid var(--border);
  }

  .stat dt {
    font-size: 12px;
    color: var(--text-faint);
  }

  .stat dd {
    margin-top: 4px;
    font-size: 24px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .canvas {
    display: grid;
    grid-template-columns: var(--columns);
    column-gap: var(--cell-gap);
    row-gap: 8px;
  }

  .months {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    font-size: 12px;
    line-height: 1;
    color: var(--text-muted);
  }

  .months span {
    grid-row: 1;
    white-space: nowrap;
  }

  .months-half {
    display: none;
  }

  .half {
    grid-column: span var(--span);
    display: grid;
    grid-template-columns: subgrid;
    row-gap: 8px;
  }

  .grid {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    grid-template-rows: repeat(7, auto);
    grid-auto-flow: column;
    row-gap: var(--cell-gap);
  }

  .cell {
    display: block;
    aspect-ratio: 1;
    border-radius: 2px;
    background: var(--contrib-0);
  }

  .cell[data-level='1'] {
    background: var(--contrib-1);
  }

  .cell[data-level='2'] {
    background: var(--contrib-2);
  }

  .cell[data-level='3'] {
    background: var(--contrib-3);
  }

  .cell[data-level='4'] {
    background: var(--contrib-4);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
  }

  .caption {
    font-size: 13px;
    color: var(--text-muted);
  }

  .source {
    white-space: nowrap;
  }

  .caption a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 4px;
    transition: text-decoration-color 0.15s ease;
  }

  .caption a:hover {
    text-decoration-color: currentColor;
  }

  .legend {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--text-muted);
  }

  .swatches {
    display: flex;
    gap: var(--cell-gap);
  }

  .swatches .cell {
    width: 11px;
  }

  @container (max-width: 639px) {
    .canvas {
      grid-template-columns: repeat(var(--split), minmax(0, 1fr));
      row-gap: 16px;
    }

    .months-full {
      display: none;
    }

    .months-half {
      display: grid;
    }

    .half {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 479px) {
    .stats {
      grid-template-columns: minmax(0, 1fr);
    }

    .stat + .stat {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }
</style>
