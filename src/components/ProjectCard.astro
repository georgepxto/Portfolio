---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import ProjectCover from './ProjectCover.astro';
import StackTags from './StackTags.astro';
import { padIndex, type Project } from '../lib/projects';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const { title, meta, summary, stack, url, cover, video, category } = project.data;
const href = `/trabalhos/${project.id}/`;
const host = url ? new URL(url).hostname.replace(/^www\./, '') : undefined;
---

<article class="project card" data-filter-item data-category={category} data-card={project.id}>
  <div class="media" transition:name={`cover-${project.id}`} transition:animate="initial">
    <ProjectCover
      cover={cover}
      video={video}
      fit="cover"
      alt={`Captura de tela do projeto ${title}`}
      widths={[400, 640, 800, 1280]}
      sizes="(min-width: 1000px) 420px, (min-width: 760px) 50vw, 100vw"
    />
  </div>
  <p class="meta mono">{padIndex(index)} · {meta}</p>
  <h3 transition:name={`title-${project.id}`} transition:animate="initial">
    <a class="stretched" href={href}>{title}</a>
  </h3>
  <p class="summary">{summary}</p>
  <div class="foot">
    <StackTags items={stack} />
    {
      url && (
        <a class="external" href={url} target="_blank" rel="noopener">
          {host}
          <ArrowUpRight aria-hidden="true" />
        </a>
      )
    }
  </div>
</article>

<style>
  .project {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 10px;
  }

  .project[hidden] {
    display: none;
  }

  .project:has(.stretched:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .media {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .media :global(img),
    .media :global(video) {
      transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
      transform-origin: left top;
    }

    .project:hover .media :global(img),
    .project:hover .media :global(video) {
      transform: scale(1.035);
    }
  }

  .meta {
    margin-top: 16px;
    padding-inline: 6px;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  h3 {
    margin-top: 8px;
    padding-inline: 6px;
    font-size: clamp(22px, 1.9vw, 26px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
  }

  .stretched {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition: text-decoration-color 0.2s ease;
  }

  .stretched:focus-visible {
    outline: none;
  }

  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .project:hover .stretched {
    text-decoration-color: currentColor;
  }

  .summary {
    margin-top: 10px;
    padding-inline: 6px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px 16px;
    margin-top: auto;
    padding: 20px 6px 6px;
  }

  .foot :global(.tags) {
    min-width: 0;
  }

  .external {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 32px;
    font-size: 13px;
    color: var(--accent);
    white-space: nowrap;
  }

  .external :global(svg) {
    width: 14px;
    height: 14px;
  }

  .external:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>

<script>
  import { onPage } from '../scripts/page';

  onPage((signal) => {
    const canPlay = matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');

    document.querySelectorAll<HTMLElement>('[data-card]').forEach((card) => {
      const video = card.querySelector<HTMLVideoElement>('[data-preview-video]');
      if (!video) return;

      const start = () => {
        if (!canPlay.matches) return;
        video.play().catch(() => {});
      };

      const stop = () => {
        video.pause();
        if (video.readyState > 0) video.currentTime = 0;
      };

      video.addEventListener('playing', () => card.setAttribute('data-playing', ''), { signal });
      video.addEventListener('pause', () => card.removeAttribute('data-playing'), { signal });
      card.addEventListener('mouseenter', start, { signal });
      card.addEventListener(
        'mouseleave',
        () => {
          if (!card.contains(document.activeElement)) stop();
        },
        { signal },
      );
      card.addEventListener('focusin', start, { signal });
      card.addEventListener(
        'focusout',
        (event) => {
          if (!card.contains(event.relatedTarget as Node | null) && !card.matches(':hover')) stop();
        },
        { signal },
      );
      canPlay.addEventListener(
        'change',
        () => {
          if (!canPlay.matches) stop();
        },
        { signal },
      );
    });
  });
</script>
