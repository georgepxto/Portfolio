---
import Dimension from './Dimension.astro';
import { tokens } from '../config/tokens';

interface Props {
  id: string;
  number: string;
  title: string;
  subtitle: string;
  dimension?: boolean;
}

const { id, number, title, subtitle, dimension = false } = Astro.props;
const headingId = `${id}-titulo`;
---

<section id={id} class="section" aria-labelledby={headingId}>
  {dimension && <Dimension axis="vertical" size={tokens.sectionPad} side="left" />}
  <div class="section-intro">
    <p class="section-number mono" aria-hidden="true">{number}</p>
    <h2 id={headingId}>{title}</h2>
    <p class="section-subtitle">{subtitle}</p>
    <slot name="intro" />
  </div>
  <div class="section-content">
    <slot />
  </div>
</section>

<style>
  .section {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 32px 48px;
    padding: var(--section-pad) var(--gutter);
  }

  .section-intro {
    flex: 1 1 200px;
    align-self: flex-start;
  }

  .section-number {
    font-size: 13px;
    color: var(--accent);
    margin-bottom: 8px;
  }

  h2 {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .section-subtitle {
    margin-top: 8px;
    max-width: 26ch;
    font-size: 14px;
    color: var(--text-muted);
  }

  .section-content {
    flex: 999 1 560px;
    min-width: 0;
  }

  @media (min-width: 960px) {
    .section-intro {
      position: sticky;
      top: 96px;
    }
  }
</style>
