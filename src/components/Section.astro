---
import GridRow from './GridRow.astro';
import Dimension from './Dimension.astro';
import { tokens } from '../config/tokens';

interface Props {
  id: string;
  number: string;
  title: string;
  subtitle: string;
  dimension?: boolean;
}

const { id, number, title, subtitle, dimension = false } = Astro.props;
const headingId = `${id}-titulo`;
---

<section id={id} class="section" aria-labelledby={headingId}>
  <GridRow class="section-title-row">
    {dimension && <Dimension axis="vertical" size={tokens.titleRow} side="left" />}
    <div class="section-title" data-reveal>
      <p class="section-number mono" aria-hidden="true">{number}</p>
      <h2 id={headingId}>{title}</h2>
    </div>
  </GridRow>
  <GridRow>
    <div class="section-subtitle" data-reveal>
      <p class="mono">{subtitle}</p>
      <slot name="aside" />
    </div>
  </GridRow>
  <slot />
</section>

<style>
  :global(.section-title-row) {
    min-height: var(--title-row);
  }

  .section-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 12px;
    padding: 12px 16px;
  }

  .section-number {
    font-size: 13px;
    color: var(--accent);
  }

  h2 {
    font-size: 28px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 16px;
    padding: 8px 16px;
  }

  .section-subtitle p {
    font-size: 13px;
    color: var(--text-muted);
  }
</style>
