---
import '@fontsource/gochi-hand/400.css';
---

<div class="cord-note" aria-hidden="true" data-cord-note transition:persist="cord-note">
  <div class="note-body">
    <svg class="note-arrow" width="46" height="40" viewBox="0 0 46 40">
      <path class="note-curve" d="M6 36 C 10 20, 22 10, 40 6"></path>
      <path class="note-tip" d="M31 2 L 40 6 L 33 13"></path>
    </svg>
    <p class="note-text">
      puxe a cordinha<br />
      <span class="note-on">pra acender a luz</span><span class="note-off">pra apagar a luz</span>
    </p>
  </div>
</div>

<p class="cord-count mono" aria-hidden="true" data-pulls data-cord-count hidden transition:persist="cord-count">
  <span class="cord-count-dot"></span>
  <span><span class="cord-count-value" data-pulls-value></span>{' '}<span data-pulls-unit data-one="puxada" data-other="puxadas">puxadas</span></span>
</p>

<style>
  .cord-note,
  .cord-count {
    display: none;
  }

  @media (min-width: 1540px) {
    .cord-note {
      position: absolute;
      top: calc(var(--header-height) + 1px + 88px);
      left: calc(50% + 598px);
      display: block;
      width: 170px;
      text-align: left;
      pointer-events: none;
      transition: opacity 500ms ease;
    }

    :global(html:not(.js)) .cord-note,
    .cord-note.is-dismissed {
      opacity: 0;
    }

    .note-body {
      font-family: 'Gochi Hand', cursive;
      font-size: 18px;
      line-height: 1.1;
      color: var(--text-muted);
      transform-origin: 0 0;
      animation: noteIn 700ms cubic-bezier(0.2, 0.7, 0.2, 1) 1.6s both;
    }

    .note-arrow {
      display: block;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
      transform: scaleX(-1);
    }

    .note-arrow path {
      stroke-dasharray: 60;
    }

    .note-curve {
      animation: arrowDraw 600ms ease-out 2s both;
    }

    .note-tip {
      animation: arrowDraw 300ms ease-out 2.45s both;
    }

    .note-text {
      padding-left: 30px;
    }

    .cord-count {
      position: absolute;
      top: calc(var(--header-height) + 1px + 60px);
      left: calc(50% + 598px);
      display: flex;
      align-items: center;
      gap: 6px;
      margin: 0;
      font-size: 11px;
      line-height: 1;
      color: var(--text-faint);
      white-space: nowrap;
      pointer-events: none;
    }

    .cord-count[hidden] {
      display: none;
    }

    .cord-count-dot {
      flex: none;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 6px color-mix(in oklab, var(--accent) 70%, transparent);
    }

    .cord-count-value {
      display: inline-block;
      color: var(--text-muted);
      font-variant-numeric: tabular-nums;
    }

    .note-off,
    :global(:root[data-theme='light']) .note-on {
      display: none;
    }

    :global(:root[data-theme='light']) .note-off {
      display: inline;
    }
  }

  @keyframes noteIn {
    from {
      opacity: 0;
      transform: translate(-6px, 6px) rotate(4deg);
    }
    to {
      opacity: 1;
      transform: rotate(4deg);
    }
  }

  @keyframes arrowDraw {
    from {
      stroke-dashoffset: 60;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .note-body {
      animation: none;
      transform: rotate(4deg);
    }

    .note-curve,
    .note-tip {
      animation: none;
    }
  }
</style>
