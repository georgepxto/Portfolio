---
import '@fontsource/gochi-hand/400.css';
---

<div class="cord-note" aria-hidden="true" data-cord-note transition:persist="cord-note">
  <div class="note-body">
    <svg class="note-arrow" width="46" height="40" viewBox="0 0 46 40">
      <path class="note-curve" d="M6 36 C 10 20, 22 10, 40 6"></path>
      <path class="note-tip" d="M31 2 L 40 6 L 33 13"></path>
    </svg>
    <p class="note-text">
      puxe a cordinha<br />
      <span class="note-on">pra acender a luz</span><span class="note-off">pra apagar a luz</span>
    </p>
  </div>
  <div class="note-compact">
    <span>
      puxe a cordinha <span class="note-on">pra acender a luz</span><span class="note-off">pra apagar a luz</span>
    </span>
    <svg class="note-arrow" width="24" height="30" viewBox="0 0 24 30">
      <path class="note-curve" d="M2 4 C 12 4, 18 12, 19 26"></path>
      <path class="note-tip" d="M14 21 L 19 27 L 23 20"></path>
    </svg>
  </div>
</div>

<p class="cord-count mono" aria-hidden="true" data-pulls data-cord-count hidden transition:persist="cord-count">
  <span class="cord-count-dot"></span>
  <span><span class="cord-count-value" data-pulls-value></span>{' '}<span data-pulls-unit data-one="puxada" data-other="puxadas">puxadas</span></span>
</p>

<style>
  .cord-note,
  .cord-count {
    --cord-box-top: calc(var(--nav-top) + var(--nav-height));
    --cord-shell: min(var(--shell), 100%);
    --cord-content: calc(var(--cord-shell) - 2 * var(--pad-x));
    --cord-box-right: calc(
      (100% - var(--cord-shell)) / 2 + var(--pad-x) + (var(--cord-content) - min(1148px, var(--cord-content))) / 2 +
        var(--cord-right)
    );
    --cord-pill-center: calc(var(--cord-box-top) + var(--cord) - 5px + 22px);
    --cord-count-height: 11px;
    --cord-count-top: calc(var(--cord-pill-center) - var(--cord-count-height) / 2);
    position: absolute;
    pointer-events: none;
  }

  .cord-note {
    top: calc(var(--cord-box-top) + 20px);
    right: calc(var(--cord-box-right) + 40px);
    transition: opacity 500ms ease;
  }

  :global(html:not(.js)) .cord-note,
  .cord-note.is-dismissed {
    opacity: 0;
  }

  .note-body {
    display: none;
  }

  .note-compact {
    display: flex;
    align-items: flex-start;
    gap: 2px;
    font-family: 'Gochi Hand', cursive;
    font-size: 17px;
    line-height: 1.1;
    color: var(--text-muted);
    white-space: nowrap;
    animation: noteInFlat 700ms cubic-bezier(0.2, 0.7, 0.2, 1) 1.6s both;
  }

  .note-arrow {
    display: block;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .note-arrow path {
    stroke-dasharray: 60;
  }

  .note-curve {
    animation: arrowDraw 600ms ease-out 2s both;
  }

  .note-tip {
    animation: arrowDraw 300ms ease-out 2.4s both;
  }

  .cord-count {
    top: var(--cord-count-top);
    right: calc(var(--cord-box-right) + 40px);
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    font-size: 11px;
    line-height: 1;
    height: var(--cord-count-height);
    color: var(--text-faint);
    white-space: nowrap;
  }

  .cord-count[hidden] {
    display: none;
  }

  .cord-count-dot {
    flex: none;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px color-mix(in oklab, var(--accent) 70%, transparent);
  }

  .cord-count-value {
    display: inline-block;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .note-off,
  :global(:root[data-theme='light']) .note-on {
    display: none;
  }

  :global(:root[data-theme='light']) .note-off {
    display: inline;
  }

  @media (max-width: 760px) {
    .note-compact {
      display: none;
    }
  }

  @media (min-width: 1540px) {
    .cord-note {
      top: calc(var(--cord-box-top) + 88px);
      right: auto;
      left: calc(50% + 598px);
      width: 170px;
      text-align: left;
    }

    .note-compact {
      display: none;
    }

    .note-body {
      display: block;
      font-family: 'Gochi Hand', cursive;
      font-size: 18px;
      line-height: 1.1;
      color: var(--text-muted);
      transform-origin: 0 0;
      animation: noteIn 700ms cubic-bezier(0.2, 0.7, 0.2, 1) 1.6s both;
    }

    .note-body .note-arrow {
      transform: scaleX(-1);
    }

    .note-body .note-tip {
      animation-delay: 2.45s;
    }

    .note-text {
      padding-left: 30px;
    }

    .cord-count {
      top: calc(var(--cord-box-top) + 60px);
      right: auto;
      left: calc(50% + 598px);
    }
  }

  @keyframes noteIn {
    from {
      opacity: 0;
      transform: translate(-6px, 6px) rotate(4deg);
    }
    to {
      opacity: 1;
      transform: rotate(4deg);
    }
  }

  @keyframes noteInFlat {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes arrowDraw {
    from {
      stroke-dashoffset: 60;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .note-body {
      animation: none;
      transform: rotate(4deg);
    }

    .note-compact {
      animation: none;
    }

    .note-curve,
    .note-tip {
      animation: none;
    }
  }
</style>
