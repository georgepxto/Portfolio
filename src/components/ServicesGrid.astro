---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import GridRow from './GridRow.astro';
import type { Service } from '../data/services';

interface Props {
  items: Service[];
}

const { items } = Astro.props;
---

<ul class="services" role="list" data-reveal>
  {
    items.map((service) => (
      <GridRow as="li">
        <div class="service">
          <h3>{service.title}</h3>
          <p class="description">{service.description}</p>
          <a class="example mono" href={service.href}>
            {service.example}
            <ArrowUpRight aria-hidden="true" />
          </a>
        </div>
      </GridRow>
    ))
  }
</ul>

<style>
  .service {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 12px 40px;
    align-items: baseline;
    padding: 28px 16px;
    transition: background-color 0.15s ease;
  }

  .service:hover {
    background: var(--surface);
  }

  h3 {
    font-size: clamp(1.5rem, 2.4vw, 1.875rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .description {
    max-width: 52ch;
    font-size: 16px;
    color: var(--text-muted);
  }

  .example {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-size: 12px;
    color: var(--text-muted);
    white-space: nowrap;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .example:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .example :global(svg) {
    width: 14px;
    height: 14px;
  }
</style>
