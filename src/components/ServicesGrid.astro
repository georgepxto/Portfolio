---
import GridRow from './GridRow.astro';
import type { Service } from '../data/services';

interface Props {
  items: Service[];
}

const { items } = Astro.props;
---

<GridRow>
  <ul class="services" role="list">
    {
      items.map((service) => (
        <li class="cell">
          <h3>{service.title}</h3>
          <p class="description">{service.description}</p>
          <p class="example mono">{service.example}</p>
        </li>
      ))
    }
  </ul>
</GridRow>

<style>
  .services {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .cell {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px 16px;
  }

  .cell + .cell {
    border-left: 1px solid var(--border);
  }

  h3 {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.35;
  }

  .description {
    font-size: 15px;
    color: var(--text-muted);
  }

  .example {
    margin-top: auto;
    padding-top: 14px;
    font-size: 12px;
    color: var(--text-faint);
  }

  @media (max-width: 719px) {
    .services {
      grid-template-columns: minmax(0, 1fr);
    }

    .cell + .cell {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }
</style>
