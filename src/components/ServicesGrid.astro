---
import type { Service } from '../data/services';

interface Props {
  items: Service[];
}

const { items } = Astro.props;
---

<ul class="services" role="list">
  {
    items.map((service) => (
      <li class="cell">
        <h3>{service.title}</h3>
        <p class="description">{service.description}</p>
        <p class="example mono">{service.example}</p>
      </li>
    ))
  }
</ul>

<style>
  .services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  .cell {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    background: var(--bg);
  }

  h3 {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.35;
  }

  .description {
    font-size: 15px;
    color: var(--text-muted);
  }

  .example {
    margin-top: auto;
    padding-top: 14px;
    font-size: 12px;
    color: var(--text-faint);
  }
</style>
