---
import GridRow from './GridRow.astro';
import { padIndex } from '../lib/projects';
import type { Guarantee, ProcessStep } from '../data/process';

interface Props {
  steps: ProcessStep[];
  guarantees: Guarantee[];
}

const { steps, guarantees } = Astro.props;
---

<GridRow>
  <ol class="steps" role="list" data-reveal>
    {
      steps.map((step, index) => (
        <li class="step">
          <span class="step-number mono" aria-hidden="true">{padIndex(index + 1)}</span>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </li>
      ))
    }
  </ol>
</GridRow>

<GridRow>
  <dl class="guarantees" data-reveal>
    {
      guarantees.map((guarantee) => (
        <div class="guarantee">
          <dt class="mono">{guarantee.label}</dt>
          <dd>{guarantee.value}</dd>
        </div>
      ))
    }
  </dl>
</GridRow>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    padding: 24px 16px;
  }

  .step + .step {
    border-left: 1px solid var(--border);
  }

  .step-number {
    font-size: 13px;
    color: var(--accent);
  }

  h3 {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.35;
  }

  .step p {
    font-size: 15px;
    color: var(--text-muted);
  }

  .guarantees {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .guarantee {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
    min-width: 0;
    padding: 14px 16px;
  }

  .guarantee + .guarantee {
    border-left: 1px solid var(--border);
  }

  .guarantee dt {
    font-size: 12px;
    color: var(--text-faint);
  }

  .guarantee dd {
    font-size: 15px;
    color: var(--text);
    text-align: right;
  }

  @media (max-width: 880px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .step:nth-child(odd) {
      border-left: 0;
    }

    .step:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }

  @media (max-width: 640px) {
    .guarantees {
      grid-template-columns: minmax(0, 1fr);
    }

    .guarantee + .guarantee {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }

  @media (max-width: 480px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }

    .step + .step {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }
</style>
