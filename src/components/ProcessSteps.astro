---
import { padIndex } from '../lib/projects';
import type { Guarantee, ProcessStep } from '../data/process';

interface Props {
  steps: ProcessStep[];
  guarantees: Guarantee[];
}

const { steps, guarantees } = Astro.props;
---

<ol class="steps" role="list" data-timeline>
  {
    steps.map((step, index) => (
      <li class="step">
        <span class="track" aria-hidden="true">
          <span class="track-line" />
          <span class="track-fill" data-tl />
          <span class="node mono">{padIndex(index + 1)}</span>
        </span>
        <h3>{step.title}</h3>
        <p>{step.description}</p>
      </li>
    ))
  }
</ol>

<dl class="guarantees" data-reveal>
  {
    guarantees.map((guarantee) => (
      <div class="guarantee">
        <dt class="mono">{guarantee.label}</dt>
        <dd>{guarantee.value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 24px;
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .track {
    position: relative;
    display: block;
    height: 32px;
    margin-bottom: 18px;
  }

  .track-line,
  .track-fill {
    position: absolute;
    top: 15.5px;
    left: 0;
    width: calc(100% + 24px);
    height: 1px;
  }

  .step:last-child .track-line,
  .step:last-child .track-fill {
    width: 100%;
  }

  .track-line {
    background: var(--border-strong);
  }

  .track-fill {
    background: var(--accent);
    transform-origin: left;
  }

  .node {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--accent);
    border-radius: 50%;
    background: var(--bg);
    font-size: 11px;
    line-height: 1;
    color: var(--accent);
  }

  h3 {
    font-size: clamp(19px, 1.5vw, 22px);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .step p {
    max-width: 32ch;
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .guarantees {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(40px, 4.4vw, 64px);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .guarantee {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    padding: 20px 24px;
  }

  .guarantee:first-child {
    padding-left: 0;
  }

  .guarantee + .guarantee {
    border-left: 1px solid var(--border);
  }

  .guarantee dt {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .guarantee dd {
    font-size: clamp(17px, 1.4vw, 20px);
    font-weight: 500;
    color: var(--text);
  }

  @media (max-width: 1000px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 40px 24px;
    }

    .step:nth-child(2n) .track-line,
    .step:nth-child(2n) .track-fill {
      width: 100%;
    }
  }

  @media (max-width: 760px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .track-line,
    .track-fill,
    .step:nth-child(2n) .track-line,
    .step:nth-child(2n) .track-fill {
      width: 100%;
    }

    .guarantees {
      grid-template-columns: minmax(0, 1fr);
    }

    .guarantee,
    .guarantee:first-child {
      padding: 16px 0;
    }

    .guarantee + .guarantee {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }
</style>
