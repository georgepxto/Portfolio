---
import GridRow from './GridRow.astro';
import { padIndex } from '../lib/projects';
import type { Guarantee, ProcessStep } from '../data/process';

interface Props {
  steps: ProcessStep[];
  guarantees: Guarantee[];
}

const { steps, guarantees } = Astro.props;
---

<GridRow>
  <ol class="steps" role="list" data-timeline>
    {
      steps.map((step, index) => (
        <li class="step">
          <span class="track" aria-hidden="true">
            <span class="track-line" />
            <span class="track-fill" data-tl />
            <span class="node mono">{padIndex(index + 1)}</span>
          </span>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </li>
      ))
    }
  </ol>
</GridRow>

<GridRow>
  <dl class="guarantees" data-reveal>
    {
      guarantees.map((guarantee) => (
        <div class="guarantee">
          <dt class="mono">{guarantee.label}</dt>
          <dd>{guarantee.value}</dd>
        </div>
      ))
    }
  </dl>
</GridRow>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    padding: 24px 0 28px;
  }

  .track {
    position: relative;
    display: block;
    height: 28px;
    margin-bottom: 10px;
  }

  .track-line,
  .track-fill {
    position: absolute;
    top: 13.5px;
    left: 0;
    width: 100%;
    height: 1px;
  }

  .track-line {
    background: var(--border-strong);
  }

  .track-fill {
    background: var(--accent);
    transform-origin: left;
  }

  .node {
    position: absolute;
    top: 0;
    left: 16px;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--accent);
    border-radius: 50%;
    background: var(--bg);
    font-size: 11px;
    line-height: 1;
    color: var(--accent);
  }

  h3,
  .step p {
    padding-left: 16px;
    padding-right: 16px;
  }

  h3 {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
  }

  .step p {
    font-size: 15px;
    color: var(--text-muted);
  }

  .guarantees {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .guarantee {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
    min-width: 0;
    padding: 14px 16px;
  }

  .guarantee + .guarantee {
    border-left: 1px solid var(--border);
  }

  .guarantee dt {
    font-size: 12px;
    color: var(--text-faint);
  }

  .guarantee dd {
    font-size: 15px;
    color: var(--text);
    text-align: right;
  }

  @media (max-width: 880px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .step:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }

  @media (max-width: 640px) {
    .guarantees {
      grid-template-columns: minmax(0, 1fr);
    }

    .guarantee + .guarantee {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }

  @media (max-width: 480px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }

    .step + .step {
      border-top: 1px solid var(--border);
    }
  }
</style>
