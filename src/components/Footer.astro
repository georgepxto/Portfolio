---
import GridRow from './GridRow.astro';
import { fullName, site } from '../config/site';

const year = new Date().getFullYear();
---

<GridRow as="footer">
  <div class="site-footer mono">
    <p>© {year} {fullName}</p>
    <p class="pulls" data-pulls hidden>
      <span class="pulls-dot" aria-hidden="true"></span>
      <span>
        A luz já foi puxada <span class="pulls-value" data-pulls-value></span>{' '}<span data-pulls-unit data-one="vez" data-other="vezes">vezes</span>
      </span>
    </p>
    <p>{site.city}, {site.state} · Brasil</p>
  </div>
</GridRow>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding: 20px 16px;
    font-size: 12px;
    color: var(--text-faint);
  }

  .pulls {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pulls[hidden] {
    display: none;
  }

  .pulls-dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px color-mix(in oklab, var(--accent) 70%, transparent);
  }

  .pulls-value {
    display: inline-block;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
</style>
