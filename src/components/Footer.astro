---
import GridRow from './GridRow.astro';
import { fullName, site } from '../config/site';

const year = new Date().getFullYear();
---

<GridRow as="footer">
  <div class="site-footer mono">
    <p>© {year} {fullName}</p>
    <p>{site.city}, {site.state} · Brasil</p>
  </div>
</GridRow>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding: 20px 16px;
    font-size: 12px;
    color: var(--text-faint);
  }
</style>
