---
import ArrowUp from '@lucide/astro/icons/arrow-up';
import { fullName } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="row mono">
    <p>© {year} {fullName}</p>
    <p class="pulls" data-pulls hidden>
      <span class="pulls-dot" aria-hidden="true"></span>
      <span>
        A luz já foi puxada <span class="pulls-value" data-pulls-value></span>{' '}<span data-pulls-unit data-one="vez" data-other="vezes">vezes</span>
      </span>
    </p>
    <a class="top-link" href="#conteudo">
      Voltar ao topo
      <ArrowUp aria-hidden="true" />
    </a>
  </div>
  <p class="signature" aria-hidden="true">george<span class="slash">/</span></p>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-gap);
    overflow: hidden;
    border-top: 1px solid var(--border);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    padding: 22px 0;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .pulls {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pulls[hidden] {
    display: none;
  }

  .pulls-dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px color-mix(in oklab, var(--accent) 70%, transparent);
  }

  .pulls-value {
    display: inline-block;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .top-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    color: var(--text-muted);
    transition: color 0.15s ease;
  }

  .top-link:hover {
    color: var(--accent);
  }

  .top-link :global(svg) {
    width: 13px;
    height: 13px;
  }

  .signature {
    margin-top: 12px;
    margin-bottom: -0.18em;
    font-family: var(--font-mono);
    font-size: clamp(96px, 21vw, 300px);
    font-weight: 500;
    line-height: 0.78;
    letter-spacing: -0.08em;
    white-space: nowrap;
    color: var(--signature);
    user-select: none;
    -webkit-user-select: none;
  }

  .slash {
    color: color-mix(in oklab, var(--accent) 16%, var(--bg));
  }

  @media (max-width: 760px) {
    .row {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
