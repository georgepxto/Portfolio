---
import GridRow from './GridRow.astro';
import { fullName, site } from '../config/site';

const year = new Date().getFullYear();
---

<GridRow as="footer" innerClass="footer-inner">
  <div class="site-footer mono">
    <p class="footer-start">
      <span>© {year} {fullName}</span>
      <a class="footer-link" href="/componentes/">Componentes</a>
    </p>
    <p class="pulls" data-pulls hidden>
      <span class="pulls-dot" aria-hidden="true"></span>
      <span>
        A luz já foi puxada <span class="pulls-value" data-pulls-value></span>{' '}<span data-pulls-unit data-one="vez" data-other="vezes">vezes</span>
      </span>
    </p>
    <p>{site.city}, {site.state} · Brasil</p>
  </div>
  <p class="signature" aria-hidden="true">george<span class="slash">/</span></p>
</GridRow>

<style>
  :global(.footer-inner) {
    overflow: hidden;
  }

  .footer-start {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
  }

  .footer-link {
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 4px;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  .footer-link:hover {
    color: var(--text);
    text-decoration-color: currentColor;
  }

  .signature {
    margin-bottom: -0.18em;
    padding: 0 12px;
    font-family: var(--font-mono);
    font-size: clamp(90px, 19vw, 260px);
    font-weight: 500;
    line-height: 0.78;
    letter-spacing: -0.08em;
    white-space: nowrap;
    color: color-mix(in oklab, var(--text) 5%, var(--bg));
    user-select: none;
    -webkit-user-select: none;
  }

  .slash {
    color: color-mix(in oklab, var(--accent) 30%, var(--bg));
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding: 20px 16px;
    font-size: 12px;
    color: var(--text-faint);
  }

  .pulls {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pulls[hidden] {
    display: none;
  }

  .pulls-dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px color-mix(in oklab, var(--accent) 70%, transparent);
  }

  .pulls-value {
    display: inline-block;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
</style>
