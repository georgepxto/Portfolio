---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Section from './Section.astro';
import { emailUrl, formatPhone, githubUrl, site, whatsappNumber, whatsappUrl } from '../config/site';

const firstLine = ['Tem', 'um', 'projeto?'];
const accentLine = ['Vamos', 'conversar.'];

const channels = [
  { label: 'WhatsApp', value: formatPhone(whatsappNumber || site.whatsapp), href: whatsappUrl, external: true },
  { label: 'E-mail', value: site.email, href: emailUrl, external: false },
  { label: 'GitHub', value: `github.com/${site.github}`, href: githubUrl, external: true },
];
---

<Section id="contato" number="09" label="Contato" info="Resposta em até 1 dia útil" class="contact">
  <h2 id="contato-titulo" data-words>
    {
      firstLine.map((word, index) => (
        <>
          {index > 0 && ' '}
          <span style="display:inline-block">{word}</span>
        </>
      ))
    }{' '}
    {
      accentLine.map((word, index) => (
        <>
          {index > 0 && ' '}
          <span style="display:inline-block" class="word-accent">
            {word}
          </span>
        </>
      ))
    }
  </h2>

  <div class="grid">
    <div class="primary" data-reveal>
      <p class="label mono">E-mail</p>
      <a class="email" href={emailUrl}>{site.email}</a>
      <div>
        <a class="button button-primary button-lg" href={whatsappUrl} target="_blank" rel="noopener">
          Chamar no WhatsApp
          <ArrowUpRight aria-hidden="true" />
        </a>
      </div>
    </div>

    <ul class="channels" role="list" data-reveal>
      {
        channels.map((channel) => (
          <li>
            <a
              class="channel"
              href={channel.href}
              target={channel.external ? '_blank' : undefined}
              rel={channel.external ? 'noopener' : undefined}
            >
              <span class="name">{channel.label}</span>
              <span class="value mono">
                {channel.value}
                <ArrowUpRight aria-hidden="true" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Section>

<style>
  h2 {
    max-width: 12ch;
    font-size: clamp(52px, 10vw, 148px);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.05em;
  }

  .word-accent {
    color: var(--accent);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: end;
    gap: 40px 56px;
    margin-top: clamp(40px, 4.4vw, 64px);
  }

  .primary {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    min-width: 0;
  }

  .label {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .email {
    max-width: 100%;
    font-size: clamp(22px, 2.4vw, 34px);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text);
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    transition: text-decoration-color 0.15s ease;
  }

  .email:hover {
    text-decoration-color: currentColor;
  }

  .primary .button {
    margin-top: 12px;
  }

  .primary .button :global(svg) {
    width: 18px;
    height: 18px;
  }

  .channels {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .channel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 68px;
    padding: 0;
    border-bottom: 1px solid var(--border);
    transition: padding 0.25s cubic-bezier(0.2, 0.7, 0.2, 1), background-color 0.15s ease;
  }

  .channel:hover {
    padding-inline: 8px;
    background: var(--surface);
  }

  .name {
    flex: none;
    font-size: 17px;
    font-weight: 500;
    color: var(--text);
  }

  .value {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    font-size: 14px;
    color: var(--text-muted);
    overflow-wrap: anywhere;
    text-align: right;
  }

  .value :global(svg) {
    flex: none;
    width: 16px;
    height: 16px;
    color: var(--text-faint);
    transition: color 0.15s ease, transform 0.2s ease;
  }

  .channel:hover .value {
    color: var(--text);
  }

  .channel:hover .value :global(svg) {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .primary .button {
      width: 100%;
    }

    .value {
      font-size: 13px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .channel {
      transition: none;
    }
  }
</style>
