---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import GridRow from './GridRow.astro';
import { emailUrl, formatPhone, githubUrl, site, whatsappNumber, whatsappUrl } from '../config/site';

const titleWords = ['Tem', 'um', 'projeto?', 'Vamos', 'conversar.'];

const channels = [
  { label: 'WhatsApp', value: formatPhone(whatsappNumber || site.whatsapp), href: whatsappUrl, accent: true, external: true },
  { label: 'E-mail', value: site.email, href: emailUrl, external: false },
  { label: 'GitHub', value: `github.com/${site.github}`, href: githubUrl, external: true },
];
---

<section id="contato" class="contact" aria-labelledby="contato-titulo">
  <GridRow>
    <h2 id="contato-titulo" data-words>
      {
        titleWords.map((word, index) => (
          <>
            {index > 0 && ' '}
            <span style="display:inline-block" class:list={[{ 'word-accent': word === 'conversar.' }]}>
              {word}
            </span>
          </>
        ))
      }
    </h2>
  </GridRow>
  <ul class="channels" role="list" data-reveal>
    {
      channels.map((channel) => (
        <GridRow as="li">
          <a
            class:list={['channel', { accent: channel.accent }]}
            href={channel.href}
            target={channel.external ? '_blank' : undefined}
            rel={channel.external ? 'noopener' : undefined}
          >
            <span class="label mono">{channel.label}</span>
            <span class="value">
              {channel.value}
              <ArrowUpRight aria-hidden="true" />
            </span>
          </a>
        </GridRow>
      ))
    }
  </ul>
</section>

<style>
  .word-accent {
    color: var(--accent);
  }

  h2 {
    max-width: 18ch;
    padding: 48px 16px;
    font-size: clamp(2.25rem, 5.5vw, 4.5rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .channel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 60px;
    padding: 0 16px;
    transition: background-color 0.15s ease;
  }

  .channel:hover {
    background: var(--surface);
  }

  .label {
    flex: none;
    font-size: 12px;
    color: var(--text-faint);
  }

  .value {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    font-size: 18px;
    color: var(--text);
    overflow-wrap: anywhere;
    text-align: right;
  }

  .value :global(svg) {
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--text-faint);
    transition: color 0.15s ease, transform 0.2s ease;
  }

  .accent .value {
    color: var(--accent);
  }

  .channel:hover .value :global(svg) {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .channel:hover .value {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  @media (max-width: 640px) {
    .value {
      font-size: 16px;
    }
  }
</style>
