---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import CodeXml from '@lucide/astro/icons/code-xml';
import MapPin from '@lucide/astro/icons/map-pin';
import Mail from '@lucide/astro/icons/mail';
import Clock from '@lucide/astro/icons/clock';
import MessageCircle from '@lucide/astro/icons/message-circle';
import Copy from '@lucide/astro/icons/copy';
import Check from '@lucide/astro/icons/check';
import { siInstagram } from 'simple-icons';
import GridRow from './GridRow.astro';
import HatchBand from './HatchBand.astro';
import Dimension from './Dimension.astro';
import LocalClock from './LocalClock.astro';
import { linkedinIcon } from '../config/brand-icons';
import { tokens } from '../config/tokens';
import { emailUrl, formatPhone, fullName, site, whatsappNumber, whatsappUrl } from '../config/site';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/photo.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const photo = Object.values(photos)[0]?.default;

const phone = formatPhone(whatsappNumber || site.whatsapp);

const socials = [
  { label: 'LinkedIn', href: site.linkedin, path: linkedinIcon.path },
  { label: 'Instagram', href: site.instagram, path: siInstagram.path },
].filter((social) => social.href);
---

<section id="topo" aria-labelledby="hero-title">
  <GridRow class="cover-row" aria-hidden="true" />
  <GridRow class="identity-row">
    <div class="name">
      <div class="avatar-cell">
        <Dimension axis="vertical" size={tokens.avatar} side="left" />
        {
          photo ? (
            <Image
              src={photo}
              alt={`Foto de ${fullName}`}
              width={tokens.avatar}
              height={tokens.avatar}
              densities={[1, 2]}
              fit="cover"
              loading="eager"
              data-hero="avatar"
            />
          ) : (
            <div class="avatar-placeholder mono" aria-hidden="true" data-hero="avatar">
              [FOTO]
            </div>
          )
        }
      </div>
      <div class="identity">
        <h1 id="hero-title" data-hero="line">{fullName}</h1>
        <p class="role mono" data-hero="line2">{site.role}.</p>
      </div>
    </div>
  </GridRow>
</section>

<HatchBand dimension />

<GridRow>
  <ul class="info" role="list" data-hero="list">
    <li class="info-focus">
      <span class="icon-box"><CodeXml aria-hidden="true" /></span>
      <span class="text">Sistemas e sites para empresas</span>
    </li>
    <li class="info-place">
      <span class="icon-box"><MapPin aria-hidden="true" /></span>
      <span class="text">{site.city}, {site.stateName}, Brasil</span>
    </li>
    <li class="info-mail">
      <span class="icon-box"><Mail aria-hidden="true" /></span>
      <a class="text" href={emailUrl}>{site.email}</a>
      <button class="copy" type="button" aria-label="Copiar e-mail" data-copy={site.email} data-done="E-mail copiado">
        <Copy class="icon-copy" aria-hidden="true" />
        <Check class="icon-check" aria-hidden="true" />
      </button>
    </li>
    <li class="info-clock">
      <span class="icon-box"><Clock aria-hidden="true" /></span>
      <LocalClock />
    </li>
    <li class="info-whatsapp">
      <span class="icon-box"><MessageCircle aria-hidden="true" /></span>
      <a class="text" href={whatsappUrl} target="_blank" rel="noopener">{phone}</a>
      <button class="copy" type="button" aria-label="Copiar número" data-copy={`+55 ${phone}`} data-done="Número copiado">
        <Copy class="icon-copy" aria-hidden="true" />
        <Check class="icon-check" aria-hidden="true" />
      </button>
    </li>
    <li class="info-status">
      <span class="icon-box"><span class="status-dot" aria-hidden="true"></span></span>
      <span class="text accent">Disponível para novos projetos</span>
    </li>
  </ul>
  <span class="visually-hidden" role="status" data-copy-status></span>
</GridRow>

<GridRow>
  <div class="links" data-hero="cta">
    {
      socials.length > 0 && (
        <ul class="socials" role="list">
          {socials.map((social) => (
            <li>
              <a class="social" href={social.href} target="_blank" rel="noopener" aria-label={`${social.label} de ${fullName}`}>
                <span class="social-box">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                    <path d={social.path} />
                  </svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
    <a class="button button-primary whatsapp" href={whatsappUrl} target="_blank" rel="noopener">
      <span class="whatsapp-long">Pedir orçamento no WhatsApp</span>
      <span class="whatsapp-short">Orçamento</span>
      <ArrowUpRight aria-hidden="true" />
    </a>
  </div>
</GridRow>

<style>
  :global(.cover-row),
  :global(.identity-row) {
    background-color: var(--bg);
    background-image: radial-gradient(var(--dot-grid) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  :global(.cover-row) {
    --row-border: 0;
    height: var(--cover);
  }

  :global(.identity-row) {
    background-position: 0 calc(-1 * var(--cover));
  }

  .name {
    display: flex;
    align-items: flex-end;
  }

  .avatar-cell {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    box-sizing: content-box;
    width: var(--avatar);
    height: var(--avatar);
    border-right: 1px solid var(--border);
  }

  .avatar-cell :global(img),
  .avatar-placeholder {
    display: block;
    width: var(--avatar-photo);
    height: var(--avatar-photo);
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    object-fit: cover;
  }

  .avatar-placeholder {
    display: grid;
    place-items: center;
    background: var(--surface);
    font-size: 12px;
    color: var(--text-faint);
  }

  .identity {
    flex: 1;
    min-width: 0;
  }

  h1,
  .role {
    border-top: 1px solid var(--border);
    background: var(--bg);
  }

  h1 {
    padding: 12px 16px;
    font-size: 36px;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  .role {
    padding: 8px 16px;
    font-size: 14px;
    color: var(--text-muted);
  }

  .info {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(3, auto);
    grid-auto-flow: column;
    row-gap: 12px;
    margin: 0;
    padding: 16px 0;
    list-style: none;
  }

  .info::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: var(--border);
  }

  .info li {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    padding-inline: 16px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text);
  }

  .info li:nth-child(n + 4) {
    padding-left: 17px;
  }

  .icon-box {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    color: var(--text-muted);
  }

  .icon-box :global(svg) {
    width: 16px;
    height: 16px;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .status-dot {
      animation: status-pulse 1800ms ease-out infinite;
    }
  }

  @keyframes status-pulse {
    from {
      box-shadow: 0 0 0 0 color-mix(in oklab, var(--accent) 60%, transparent);
    }
    to {
      box-shadow: 0 0 0 7px transparent;
    }
  }

  .text {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .accent {
    color: var(--accent);
  }

  a.text {
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 4px;
    transition: text-decoration-color 0.15s ease;
  }

  a.text:hover {
    text-decoration-color: currentColor;
  }

  .copy {
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin-left: -6px;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--text-faint);
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .copy:hover {
    color: var(--text);
    background: var(--surface);
  }

  .copy :global(svg) {
    width: 16px;
    height: 16px;
  }

  .copy :global(.icon-check),
  .copy[data-copied] :global(.icon-copy) {
    display: none;
  }

  .copy[data-copied] {
    color: var(--accent);
  }

  .copy[data-copied] :global(.icon-check) {
    display: block;
  }

  :global(html:not(.js)) .copy {
    display: none;
  }

  .links {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 16px;
    padding: 12px 16px 12px 12px;
  }

  .socials {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 4px;
    color: var(--text-muted);
  }

  .social-box {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
  }

  .social-box svg {
    width: 16px;
    height: 16px;
  }

  .social:hover {
    color: var(--text);
  }

  .social:hover .social-box {
    border-color: var(--text-faint);
    background: var(--surface);
  }

  .whatsapp {
    margin-left: auto;
  }

  .whatsapp-short {
    display: none;
  }

  @media (max-width: 640px) {
    :global(.cover-row) {
      --row-border: 1px solid var(--border);
    }

    :global(.identity-row) {
      background: var(--bg);
    }

    .name {
      align-items: stretch;
    }

    .identity {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
    }

    h1 {
      padding: 8px 10px;
      font-size: clamp(1.375rem, 7vw, 1.75rem);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      overflow-wrap: normal;
    }

    .role {
      padding: 6px 10px;
      font-size: 12px;
    }

    .info {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-auto-flow: row;
      row-gap: 8px;
      padding: 12px;
    }

    .info::before {
      display: none;
    }

    .info li,
    .info li:nth-child(n + 4) {
      gap: 10px;
      padding-inline: 0;
      font-size: 13px;
    }

    .info-focus {
      order: 1;
    }

    .info-place {
      order: 2;
    }

    .info-clock {
      order: 3;
    }

    .info-mail {
      order: 4;
    }

    .info-whatsapp {
      order: 5;
    }

    .info-status {
      order: 6;
    }

    .icon-box {
      width: 28px;
      height: 28px;
    }

    .copy {
      margin-left: -4px;
    }

    .links {
      gap: 12px;
      padding: 8px 12px 8px 8px;
    }

    .whatsapp {
      min-height: 36px;
      height: 36px;
      gap: 6px;
      padding: 0 14px;
      font-size: 13px;
      font-weight: 600;
    }

    .whatsapp :global(svg) {
      width: 16px;
      height: 16px;
    }

    .whatsapp-long {
      display: none;
    }

    .whatsapp-short {
      display: inline;
    }
  }
</style>

<script>
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  const timers = new WeakMap<HTMLElement, number>();

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
      } catch {
        return;
      }
      button.dataset.copied = '';
      if (status) status.textContent = button.dataset.done ?? '';
      window.clearTimeout(timers.get(button));
      timers.set(
        button,
        window.setTimeout(() => {
          delete button.dataset.copied;
          if (status) status.textContent = '';
        }, 1500),
      );
    });
  });
</script>
