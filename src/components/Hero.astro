---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import MapPin from '@lucide/astro/icons/map-pin';
import Mail from '@lucide/astro/icons/mail';
import Clock from '@lucide/astro/icons/clock';
import MessageCircle from '@lucide/astro/icons/message-circle';
import Copy from '@lucide/astro/icons/copy';
import Check from '@lucide/astro/icons/check';
import { siInstagram } from 'simple-icons';
import LocalClock from './LocalClock.astro';
import DotField from './DotField.astro';
import { linkedinIcon } from '../config/brand-icons';
import { emailUrl, formatPhone, fullName, site, whatsappNumber, whatsappUrl } from '../config/site';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/photo.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const photo = Object.values(photos)[0]?.default;

const phone = formatPhone(whatsappNumber || site.whatsapp);
const year = new Date().getFullYear();

const socials = [
  { label: 'LinkedIn', href: site.linkedin, path: linkedinIcon.path },
  { label: 'Instagram', href: site.instagram, path: siInstagram.path },
].filter((social) => social.href);
---

<section id="topo" class="hero" aria-labelledby="hero-title">
  <div class="hero-fallback" aria-hidden="true"></div>
  <DotField class="hero-dots" origin="corner" radius={150} grow={3.6} />

  <p class="eyebrow mono">Portfólio / {year} · {site.city}, {site.state} · Brasil</p>

  <div class="layout">
    <div class="identity">
      <div class="who">
        {
          photo ? (
            <Image
              class="avatar"
              src={photo}
              alt={`Foto de ${fullName}`}
              width={168}
              height={168}
              densities={[1, 2]}
              fit="cover"
              loading="eager"
              data-hero="avatar"
            />
          ) : (
            <div class="avatar avatar-placeholder mono" aria-hidden="true" data-hero="avatar">
              [FOTO]
            </div>
          )
        }
        <p class="roles mono">
          <span class="role">{site.role}</span>
          <span>Sistemas e sites para empresas</span>
        </p>
      </div>

      <h1 id="hero-title" data-hero="line">{site.name}<br />{site.surname}</h1>
      <p class="claim" data-hero="line2">Sistemas e sites que vão para produção.</p>

      <div class="actions" data-hero="cta">
        <a class="button button-primary button-lg" href={whatsappUrl} target="_blank" rel="noopener">
          Pedir orçamento no WhatsApp
          <ArrowUpRight aria-hidden="true" />
        </a>
        <p class="status mono">
          <span class="status-dot" aria-hidden="true"></span>
          Disponível para novos projetos
        </p>
        {
          socials.length > 0 && (
            <ul class="socials" role="list">
              {socials.map((social) => (
                <li>
                  <a class="social" href={social.href} target="_blank" rel="noopener" aria-label={`${social.label} de ${fullName}`}>
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                      <path d={social.path} />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>

    <ul class="info" role="list" data-hero="list">
      <li class="row split">
        <span class="cell">
          <span class="icon-box"><MapPin aria-hidden="true" /></span>
          <span class="text">{site.city}, {site.stateName}</span>
        </span>
        <span class="cell">
          <span class="icon-box"><Clock aria-hidden="true" /></span>
          <LocalClock note="// Brasília" />
        </span>
      </li>
      <li class="row">
        <span class="cell">
          <span class="icon-box"><Mail aria-hidden="true" /></span>
          <a class="text link" href={emailUrl}>{site.email}</a>
        </span>
        <button class="copy mono" type="button" aria-label="Copiar e-mail" data-copy={site.email} data-done="E-mail copiado">
          <Copy class="icon-copy" aria-hidden="true" />
          <Check class="icon-check" aria-hidden="true" />
          <span class="copy-label" aria-hidden="true">copiar</span>
        </button>
      </li>
      <li class="row">
        <span class="cell">
          <span class="icon-box"><MessageCircle aria-hidden="true" /></span>
          <a class="text link" href={whatsappUrl} target="_blank" rel="noopener">{phone}</a>
        </span>
        <button class="copy mono" type="button" aria-label="Copiar número" data-copy={`+55 ${phone}`} data-done="Número copiado">
          <Copy class="icon-copy" aria-hidden="true" />
          <Check class="icon-check" aria-hidden="true" />
          <span class="copy-label" aria-hidden="true">copiar</span>
        </button>
      </li>
    </ul>
  </div>
  <span class="visually-hidden" role="status" data-copy-status></span>
</section>

<style>
  .hero {
    position: relative;
    padding-top: 150px;
  }

  .hero-fallback,
  .hero :global(.hero-dots) {
    position: absolute;
    top: 0;
    bottom: calc(-1 * var(--section-gap) / 2);
    left: calc(50% - 50cqw);
    width: 100cqw;
    -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent);
    mask-image: linear-gradient(to bottom, #000 72%, transparent);
  }

  .hero :global(.hero-dots) {
    right: auto;
    height: auto;
  }

  .hero-fallback {
    background-image: radial-gradient(var(--dot-grid) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .hero:has(:global(.hero-dots[data-ready])) .hero-fallback,
  :global(html:not(.js)) .hero :global(.hero-dots) {
    display: none;
  }

  .eyebrow,
  .layout {
    position: relative;
  }

  .eyebrow {
    padding-right: 72px;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: end;
    gap: 40px 56px;
    margin-top: 28px;
  }

  .who {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .avatar {
    flex: none;
    width: clamp(120px, 14vw, 168px);
    height: clamp(120px, 14vw, 168px);
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    object-fit: cover;
  }

  .avatar-placeholder {
    display: grid;
    place-items: center;
    background: var(--surface);
    font-size: 12px;
    color: var(--text-faint);
  }

  .roles {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .role {
    color: var(--accent);
  }

  h1 {
    margin-top: 28px;
    font-size: clamp(56px, 10vw, 148px);
    font-weight: 600;
    line-height: 0.86;
    letter-spacing: -0.055em;
  }

  .claim {
    max-width: 24ch;
    margin-top: 24px;
    font-size: clamp(20px, 1.9vw, 26px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--text-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 32px;
  }

  .actions .button :global(svg) {
    width: 18px;
    height: 18px;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .status-dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .status-dot {
      animation: status-pulse 1800ms ease-out infinite;
    }
  }

  @keyframes status-pulse {
    from {
      box-shadow: 0 0 0 0 color-mix(in oklab, var(--accent) 60%, transparent);
    }
    to {
      box-shadow: 0 0 0 7px transparent;
    }
  }

  .socials {
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    color: var(--text-muted);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .social:hover {
    border-color: var(--text-faint);
    color: var(--text);
  }

  .social svg {
    width: 16px;
    height: 16px;
  }

  .info {
    container-type: inline-size;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--bg);
  }

  @container (max-width: 420px) {
    .info .split {
      grid-template-columns: minmax(0, 1fr);
    }

    .info .split .cell + .cell {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 64px;
    padding: 10px 0;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text);
  }

  .row:last-child {
    border-bottom: 1px solid var(--border);
  }

  .split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    padding: 0;
  }

  .split .cell {
    padding: 10px 0;
  }

  .split .cell + .cell {
    padding-left: 16px;
    border-left: 1px solid var(--border);
  }

  .cell {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .icon-box {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    color: var(--text-muted);
  }

  .icon-box :global(svg) {
    width: 16px;
    height: 16px;
  }

  .text {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .link {
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 4px;
    transition: text-decoration-color 0.15s ease;
  }

  .link:hover {
    text-decoration-color: currentColor;
  }

  .copy {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    padding: 0 10px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--text-muted);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .copy:hover {
    border-color: var(--text-faint);
    color: var(--text);
  }

  .copy :global(svg) {
    width: 13px;
    height: 13px;
  }

  .copy :global(.icon-check),
  .copy[data-copied] :global(.icon-copy) {
    display: none;
  }

  .copy[data-copied] {
    border-color: color-mix(in oklab, var(--accent) 50%, transparent);
    color: var(--accent);
  }

  .copy[data-copied] :global(.icon-check) {
    display: block;
  }

  :global(html:not(.js)) .copy {
    display: none;
  }

  @media (max-width: 1000px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
  }

  @media (max-width: 760px) {
    .hero {
      padding-top: 120px;
    }

    .who {
      gap: 16px;
    }

    .split {
      grid-template-columns: minmax(0, 1fr);
    }

    .split .cell + .cell {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--border);
    }

    .row {
      font-size: 13px;
    }

    .actions .button {
      width: 100%;
    }
  }
</style>

<script>
  import { onPage } from '../scripts/page';

  onPage((signal) => {
    const status = document.querySelector<HTMLElement>('[data-copy-status]');
    const timers = new Set<number>();

    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
      let timer = 0;
      const label = button.querySelector<HTMLElement>('.copy-label');

      button.addEventListener(
        'click',
        async () => {
          try {
            await navigator.clipboard.writeText(button.dataset.copy ?? '');
          } catch {
            return;
          }
          button.dataset.copied = '';
          if (label) label.textContent = 'copiado';
          if (status) status.textContent = button.dataset.done ?? '';
          window.clearTimeout(timer);
          timers.delete(timer);
          timer = window.setTimeout(() => {
            delete button.dataset.copied;
            if (label) label.textContent = 'copiar';
            if (status) status.textContent = '';
          }, 1500);
          timers.add(timer);
        },
        { signal },
      );
    });

    return () => timers.forEach((timer) => window.clearTimeout(timer));
  });
</script>
