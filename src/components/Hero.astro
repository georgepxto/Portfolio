---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import CodeXml from '@lucide/astro/icons/code-xml';
import MapPin from '@lucide/astro/icons/map-pin';
import Mail from '@lucide/astro/icons/mail';
import Clock from '@lucide/astro/icons/clock';
import MessageCircle from '@lucide/astro/icons/message-circle';
import { siGithub, siInstagram } from 'simple-icons';
import GridRow from './GridRow.astro';
import HatchBand from './HatchBand.astro';
import Dimension from './Dimension.astro';
import LocalClock from './LocalClock.astro';
import { linkedinIcon } from '../config/brand-icons';
import { tokens } from '../config/tokens';
import { emailUrl, formatPhone, fullName, githubUrl, site, whatsappNumber, whatsappUrl } from '../config/site';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/photo.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const photo = Object.values(photos)[0]?.default;

const socials = [
  { label: 'GitHub', href: site.github ? githubUrl : '', path: siGithub.path },
  { label: 'LinkedIn', href: site.linkedin, path: linkedinIcon.path },
  { label: 'Instagram', href: site.instagram, path: siInstagram.path },
].filter((social) => social.href);
---

<GridRow as="section" id="topo" class="name-row" aria-labelledby="hero-title">
  <div class="name">
    <div class="avatar-cell">
      <Dimension axis="vertical" size={tokens.avatar} label={`Ø${tokens.avatar}`} side="left" />
      {
        photo ? (
          <Image
            src={photo}
            alt={`Foto de ${fullName}`}
            width={tokens.avatar}
            height={tokens.avatar}
            densities={[1, 2]}
            fit="cover"
            loading="eager"
          />
        ) : (
          <div class="avatar-placeholder mono" aria-hidden="true">
            [FOTO]
          </div>
        )
      }
    </div>
    <div class="identity">
      <h1 id="hero-title">{fullName}</h1>
      <p class="role mono">{site.role}.</p>
    </div>
  </div>
</GridRow>

<HatchBand dimension />

<GridRow>
  <div class="info">
    <ul class="info-col" role="list">
      <li>
        <span class="icon-box"><CodeXml aria-hidden="true" /></span>
        <span>Desenvolvedor web freelancer</span>
      </li>
      <li>
        <span class="icon-box"><MapPin aria-hidden="true" /></span>
        <span>{site.city}, {site.stateName}, Brasil</span>
      </li>
      <li>
        <span class="icon-box"><Mail aria-hidden="true" /></span>
        <a href={emailUrl}>{site.email}</a>
      </li>
    </ul>
    <ul class="info-col info-col-end" role="list">
      <li>
        <span class="icon-box"><Clock aria-hidden="true" /></span>
        <LocalClock />
      </li>
      <li>
        <span class="icon-box"><MessageCircle aria-hidden="true" /></span>
        <a href={whatsappUrl} target="_blank" rel="noopener">{formatPhone(whatsappNumber || site.whatsapp)}</a>
      </li>
      <li>
        <span class="icon-box"><span class="status-dot" aria-hidden="true"></span></span>
        <span class="accent">Disponível para novos projetos</span>
      </li>
    </ul>
  </div>
</GridRow>

<GridRow>
  <div class="links">
    {
      socials.length > 0 && (
        <ul class="socials" role="list">
          {socials.map((social) => (
            <li>
              <a class="social" href={social.href} target="_blank" rel="noopener" aria-label={`${social.label} de ${fullName}`}>
                <span class="social-box">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                    <path d={social.path} />
                  </svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
    <a class="button button-primary whatsapp" href={whatsappUrl} target="_blank" rel="noopener">
      Conversar no WhatsApp
      <ArrowUpRight aria-hidden="true" />
    </a>
  </div>
</GridRow>

<style>
  :global(.name-row) {
    height: var(--name-row);
    background-color: var(--bg);
    background-image: radial-gradient(var(--dot-grid) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .name {
    display: flex;
    align-items: flex-end;
    height: 100%;
  }

  .avatar-cell {
    position: relative;
    flex: none;
    box-sizing: content-box;
    width: var(--avatar);
    height: var(--avatar);
    border-right: 1px solid var(--border);
  }

  .avatar-cell :global(img),
  .avatar-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    object-fit: cover;
  }

  .avatar-placeholder {
    display: grid;
    place-items: center;
    background: var(--surface);
    font-size: 12px;
    color: var(--text-faint);
  }

  .identity {
    flex: 1;
    min-width: 0;
  }

  h1,
  .role {
    border-top: 1px solid var(--border);
    background: var(--bg);
  }

  h1 {
    padding: 12px 16px;
    font-size: 36px;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  .role {
    padding: 8px 16px;
    font-size: 14px;
    color: var(--text-muted);
  }

  .info {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .info-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 16px;
    list-style: none;
  }

  .info-col + .info-col {
    border-left: 1px solid var(--border);
  }

  .info-col-end {
    justify-content: flex-end;
  }

  .info li {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text);
  }

  .icon-box {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    color: var(--text-muted);
  }

  .icon-box :global(svg) {
    width: 16px;
    height: 16px;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  .accent {
    color: var(--accent);
  }

  .info a {
    min-width: 0;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 4px;
    transition: text-decoration-color 0.15s ease;
  }

  .info a:hover {
    text-decoration-color: currentColor;
  }

  .links {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 16px;
    padding: 12px 16px 12px 12px;
  }

  .socials {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 4px;
    color: var(--text-muted);
  }

  .social-box {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
  }

  .social-box svg {
    width: 16px;
    height: 16px;
  }

  .social:hover {
    color: var(--text);
  }

  .social:hover .social-box {
    border-color: var(--text-faint);
    background: var(--surface);
  }

  .whatsapp {
    margin-left: auto;
  }

  @media (max-width: 639px) {
    .info {
      grid-template-columns: minmax(0, 1fr);
    }

    .info-col + .info-col {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }

  @media (max-width: 640px) {
    :global(.name-row) {
      height: auto;
    }

    .name {
      flex-direction: column;
      align-items: stretch;
      padding-top: var(--cover-mobile);
    }

    .avatar-cell {
      width: var(--avatar-mobile);
      height: var(--avatar-mobile);
    }

    .links {
      flex-direction: column;
      align-items: stretch;
      padding: 12px 16px;
    }

    .socials {
      margin-left: -4px;
    }

    .whatsapp {
      width: 100%;
      margin-left: 0;
    }
  }
</style>
