---
import GridRow from './GridRow.astro';
import type { Testimonial } from '../data/testimonials';

interface Props {
  items: Testimonial[];
}

const { items } = Astro.props;
---

<GridRow>
  <ul class="testimonials" role="list" data-reveal>
    {
      items.map((item) => (
        <li class="cell">
          <figure>
            <blockquote>
              <p>{item.text}</p>
            </blockquote>
            <figcaption>
              <span class="name">{item.name}</span>
              <span class="role mono">{item.role}</span>
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</GridRow>

<style>
  .testimonials {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .cell {
    min-width: 0;
    padding: 24px 16px;
  }

  .cell + .cell {
    border-left: 1px solid var(--border);
  }

  figure {
    display: flex;
    flex-direction: column;
    gap: 20px;
    height: 100%;
  }

  blockquote {
    margin: 0;
    font-size: 17px;
    line-height: 1.55;
    color: var(--text-soft);
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: auto;
  }

  .name {
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
  }

  .role {
    font-size: 12px;
    color: var(--text-faint);
  }

  @media (max-width: 719px) {
    .testimonials {
      grid-template-columns: minmax(0, 1fr);
    }

    .cell + .cell {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }
</style>
