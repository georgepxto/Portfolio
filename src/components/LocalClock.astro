<span class="clock-wrap">
  <span class="clock" data-local-clock aria-live="off">
    <time>--:--</time>
    <span class="clock-diff clock-long" data-clock-diff>// horário de Brasília (UTC−3)</span>
    <span class="clock-diff clock-short" data-clock-short>// UTC−3</span>
  </span>
</span>

<style>
  .clock-wrap {
    display: block;
    flex: 1;
    min-width: 0;
    container-type: inline-size;
  }

  .clock {
    display: flex;
    gap: 8px;
    white-space: nowrap;
  }

  time {
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .clock-diff {
    color: var(--text-faint);
  }

  .clock-short {
    display: none;
  }

  @container (max-width: 290px) {
    .clock-long {
      display: none;
    }

    .clock-short {
      display: inline;
    }
  }
</style>

<script>
  import { onPage } from '../scripts/page';

  const zone = 'America/Fortaleza';
  const clockFormat = new Intl.DateTimeFormat('pt-BR', { hour: '2-digit', minute: '2-digit', timeZone: zone });
  const partsFormat = new Intl.DateTimeFormat('en-US', {
    timeZone: zone,
    hourCycle: 'h23',
    year: 'numeric',
    month: 'numeric',
    day: 'numeric',
    hour: 'numeric',
    minute: 'numeric',
  });

  function zoneOffset(date: Date): number {
    const parts = Object.fromEntries(
      partsFormat.formatToParts(date).map((part) => [part.type, Number(part.value)]),
    );
    const wallClock = Date.UTC(parts.year, parts.month - 1, parts.day, parts.hour, parts.minute);
    const minute = Math.floor(date.getTime() / 60_000) * 60_000;
    return Math.round((wallClock - minute) / 60_000);
  }

  function formatGap(minutes: number): string {
    const hours = Math.floor(minutes / 60);
    const rest = minutes % 60;
    return rest ? `${hours}h${String(rest).padStart(2, '0')}` : `${hours}h`;
  }

  function describe(date: Date): [string, string] {
    const diff = -date.getTimezoneOffset() - zoneOffset(date);
    if (diff === 0) return ['// mesmo horário que você', '// mesmo horário'];
    const gap = formatGap(Math.abs(diff));
    return diff > 0
      ? [`// ${gap} atrás de você`, `// ${gap} atrás`]
      : [`// ${gap} à frente de você`, `// ${gap} à frente`];
  }

  function update() {
    const now = new Date();
    const time = clockFormat.format(now);
    const [note, shortNote] = describe(now);

    document.querySelectorAll<HTMLElement>('[data-local-clock]').forEach((clock) => {
      const element = clock.querySelector('time');
      const diff = clock.querySelector('[data-clock-diff]');
      const short = clock.querySelector('[data-clock-short]');
      if (element) {
        element.textContent = time;
        element.dateTime = time;
      }
      if (diff) diff.textContent = note;
      if (short) short.textContent = shortNote;
    });
  }

  onPage(() => {
    if (!document.querySelector('[data-local-clock]')) return;
    update();
    const timer = window.setInterval(update, 30_000);
    return () => window.clearInterval(timer);
  });
</script>
