---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import { whatsappUrl } from '../config/site';
---

<aside class="cta" aria-labelledby="cta-titulo" data-project-cta>
  <p class="kicker mono">Orçamento sem custo</p>
  <div class="content">
    <p id="cta-titulo" class="title">O próximo sistema pode ser o seu.</p>
    <a class="link" href={whatsappUrl} target="_blank" rel="noopener">
      Conversar no WhatsApp
      <ArrowUpRight aria-hidden="true" />
    </a>
  </div>
</aside>

<style>
  .cta {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    min-width: 0;
    min-height: 280px;
    padding: 24px;
    border: 1px solid var(--accent);
    background: color-mix(in oklab, var(--accent) 8%, var(--bg));
  }

  .kicker {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .title {
    max-width: 16ch;
    font-size: clamp(26px, 2.4vw, 34px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--text);
    text-wrap: balance;
  }

  .link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    margin-top: 16px;
    font-size: 15px;
    font-weight: 500;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.15s ease;
  }

  .link:hover {
    text-decoration-color: currentColor;
  }

  .link :global(svg) {
    width: 16px;
    height: 16px;
  }
</style>

<script>
  import { onPage } from '../scripts/page';

  onPage((signal) => {
    const cta = document.querySelector<HTMLElement>('[data-project-cta]');
    const list = cta?.parentElement;
    if (!cta || !list) return;

    list.addEventListener(
      'filterchange',
      (event) => {
        const visible = (event as CustomEvent<{ visible: HTMLElement[] }>).detail.visible;
        if (visible.length >= 2) visible[1].after(cta);
        else list.append(cta);
      },
      { signal },
    );
  });
</script>
