---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import GridRow from './GridRow.astro';
import { whatsappUrl } from '../config/site';
---

<GridRow class="cta-row" data-project-cta>
  <aside class="cta" aria-labelledby="cta-titulo">
    <p class="kicker mono">Orçamento sem custo</p>
    <p id="cta-titulo" class="title">O próximo sistema pode ser o seu.</p>
    <a class="link" href={whatsappUrl} target="_blank" rel="noopener">
      Conversar no WhatsApp
      <ArrowUpRight aria-hidden="true" />
    </a>
  </aside>
</GridRow>

<style>
  .cta {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    min-height: 248px;
    margin: 0 -1px -1px;
    padding: 24px 17px;
    border: 1px solid var(--accent);
    background: color-mix(in oklab, var(--accent) 8%, var(--bg));
  }

  .kicker {
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .title {
    max-width: 22ch;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--text);
    text-wrap: balance;
  }

  .link {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 6px;
    min-height: 44px;
    font-size: 15px;
    font-weight: 500;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.15s ease;
  }

  .link:hover {
    text-decoration-color: currentColor;
  }

  .link :global(svg) {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 640px) {
    .cta {
      min-height: 200px;
    }
  }
</style>

<script>
  import { onPage } from '../scripts/page';

  onPage((signal) => {
    const cta = document.querySelector<HTMLElement>('[data-project-cta]');
    const list = cta?.parentElement;
    if (!cta || !list) return;

    list.addEventListener(
      'filterchange',
      (event) => {
        const visible = (event as CustomEvent<{ visible: HTMLElement[] }>).detail.visible;
        if (visible.length >= 2) visible[1].after(cta);
        else list.append(cta);
      },
      { signal },
    );
  });
</script>
