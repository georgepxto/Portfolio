---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CoverPlaceholder from './CoverPlaceholder.astro';
import { fullName } from '../config/site';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/photo.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const photo = Object.values(photos)[0]?.default;
---

<div class="about">
  <div class="photo">
    {
      photo ? (
        <Image src={photo} alt={`Foto de ${fullName}`} width={320} height={400} />
      ) : (
        <CoverPlaceholder label="[SUA FOTO]" />
      )
    }
  </div>
  <div class="text">
    <p class="lead">
      Sou desenvolvedor web freelancer em Parnaíba, no Piauí. Trabalho com sistemas para o Instituto OIG, produtos SaaS
      próprios e sites para empresas da região.
    </p>
    <p class="secondary">[UM PARÁGRAFO SEU: COMO COMEÇOU, COMO TRABALHA E O QUE UM CLIENTE PODE ESPERAR]</p>
  </div>
</div>

<style>
  .about {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 32px 40px;
  }

  .photo {
    flex: none;
    width: 160px;
    height: 200px;
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .text {
    flex: 1 1 320px;
    min-width: 0;
  }

  .lead {
    max-width: 58ch;
    font-size: 17px;
    color: var(--text-soft);
  }

  .secondary {
    max-width: 58ch;
    margin-top: 16px;
    font-size: 15px;
    color: var(--text-muted);
  }
</style>
