---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CoverPlaceholder from './CoverPlaceholder.astro';
import GridRow from './GridRow.astro';
import { fullName } from '../config/site';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/photo.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const photo = Object.values(photos)[0]?.default;
---

<GridRow>
  <div class="about">
    <div class="photo">
      {
        photo ? (
          <Image src={photo} alt={`Foto de ${fullName}`} width={320} height={400} />
        ) : (
          <CoverPlaceholder label="[SUA FOTO]" />
        )
      }
    </div>
    <div class="text">
      <p class="lead">Construo sistemas de gestão, produtos SaaS e sites para empresas. Do banco de dados à interface.</p>
      <p class="lead">
        Sou desenvolvedor web freelancer em Parnaíba, no Piauí. Trabalho com sistemas para o Instituto OIG, produtos SaaS
        próprios e sites para empresas da região.
      </p>
      <p class="secondary">[UM PARÁGRAFO SEU: COMO COMEÇOU, COMO TRABALHA E O QUE UM CLIENTE PODE ESPERAR]</p>
    </div>
  </div>
</GridRow>

<style>
  .about {
    display: flex;
  }

  .photo {
    flex: none;
    box-sizing: content-box;
    width: 160px;
    border-right: 1px solid var(--border);
  }

  .photo > :global(*) {
    width: 160px;
    height: 200px;
  }

  .photo :global(img) {
    display: block;
    object-fit: cover;
  }

  .text {
    flex: 1;
    min-width: 0;
    padding: 16px;
  }

  .lead {
    max-width: 58ch;
    font-size: 17px;
    color: var(--text-soft);
  }

  .lead + .lead {
    margin-top: 16px;
  }

  .secondary {
    max-width: 58ch;
    margin-top: 16px;
    font-size: 15px;
    color: var(--text-muted);
  }

  @media (max-width: 639px) {
    .about {
      flex-direction: column;
    }

    .photo {
      width: auto;
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }
  }
</style>
