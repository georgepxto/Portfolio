---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import GridRow from './GridRow.astro';
import type { LabItem } from '../data/lab';

interface Props {
  items: LabItem[];
}

const { items } = Astro.props;
---

<ul class="lab" role="list">
  {
    items.map((item) => (
      <GridRow as="li">
        <div class="item">
          <p class="cell name">
            {item.href ? (
              <a href={item.href} target="_blank" rel="noopener">
                {item.name}
                <ArrowUpRight aria-hidden="true" />
                <span class="visually-hidden">({item.linkLabel ?? 'repositório'})</span>
              </a>
            ) : (
              item.name
            )}
          </p>
          <p class="cell description">{item.description}</p>
          <p class="cell stack mono">{item.stack}</p>
        </div>
      </GridRow>
    ))
  }
</ul>

<style>
  .item {
    display: grid;
    grid-template-columns: minmax(130px, 0.8fr) minmax(0, 2fr) minmax(120px, 1fr);
    transition: background-color 0.15s ease;
  }

  .item:hover {
    background: var(--surface);
  }

  .cell {
    min-width: 0;
    padding: 14px 16px;
  }

  .cell + .cell {
    border-left: 1px solid var(--border);
  }

  .name {
    font-weight: 500;
    color: var(--text);
  }

  .name a {
    display: inline;
    padding: 12px 0;
  }

  .name a:hover {
    color: var(--accent);
  }

  .name :global(svg) {
    display: inline-block;
    width: 14px;
    height: 14px;
    margin-left: 4px;
    vertical-align: -1px;
    color: var(--text-faint);
  }

  .description {
    font-size: 15px;
    color: var(--text-muted);
  }

  .stack {
    font-size: 12px;
    line-height: 2;
    color: var(--text-faint);
  }

  @media (max-width: 720px) {
    .item {
      grid-template-columns: minmax(0, 1fr);
      padding: 14px 0;
    }

    .item:hover {
      background: transparent;
    }

    .cell {
      padding: 0 16px;
    }

    .cell + .cell {
      border-left: 0;
      margin-top: 4px;
    }
  }
</style>
