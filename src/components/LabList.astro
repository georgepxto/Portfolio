---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import type { LabItem } from '../data/lab';

interface Props {
  items: LabItem[];
}

const { items } = Astro.props;
---

<ul class="lab" role="list" data-reveal>
  {
    items.map((item) => {
      const badge = item.href ? (item.linkLabel ?? 'repositório') : item.status;
      return (
        <li class="item card">
          <div class="top">
            <p class="name">
              {item.href ? (
                <a href={item.href} target="_blank" rel="noopener">
                  {item.name}
                  <ArrowUpRight aria-hidden="true" />
                  <span class="visually-hidden">({item.linkLabel ?? 'repositório'})</span>
                </a>
              ) : (
                item.name
              )}
            </p>
            {badge && (
              <span class:list={['badge', 'mono', { linked: Boolean(item.href) }]} aria-hidden={item.href ? 'true' : undefined}>
                {badge}
              </span>
            )}
          </div>
          <p class="description">{item.description}</p>
          <p class="stack mono">{item.stack}</p>
        </li>
      );
    })
  }
</ul>

<style>
  .lab {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 200px;
    padding: 22px;
  }

  .top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px 12px;
  }

  .name {
    min-width: 0;
    font-size: 19px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .name a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .name a:hover,
  .item:has(a:hover) .name {
    color: var(--accent);
  }

  .name a:focus-visible {
    outline: none;
  }

  .item:has(.name a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .name :global(svg) {
    display: inline-block;
    width: 15px;
    height: 15px;
    margin-left: 4px;
    vertical-align: -1px;
    color: var(--text-faint);
  }

  .badge {
    flex: none;
    margin-top: 2px;
    padding: 3px 8px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-size: 11px;
    line-height: 1.3;
    color: var(--text-faint);
    white-space: nowrap;
  }

  .linked {
    border-color: color-mix(in oklab, var(--accent) 45%, transparent);
    background: color-mix(in oklab, var(--accent) 10%, transparent);
    color: var(--accent);
  }

  .description {
    margin-top: 12px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .stack {
    margin-top: auto;
    padding-top: 20px;
    font-size: 12px;
    color: var(--text-faint);
  }

  @media (max-width: 1000px) {
    .lab {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .lab {
      grid-template-columns: minmax(0, 1fr);
    }

    .item {
      min-height: 0;
    }
  }
</style>
