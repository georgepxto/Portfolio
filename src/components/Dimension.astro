---
interface Props {
  axis: 'vertical' | 'horizontal';
  size: number;
  label?: string;
  side: 'left' | 'right';
}

const { axis, size, label = String(size), side } = Astro.props;
const length = axis === 'vertical' ? `height: ${size}px` : `width: ${size}px`;
---

<span class:list={['dimension', axis, side]} style={length} aria-hidden="true">
  <span class="dimension-label mono">{label}</span>
</span>

<style>
  .dimension {
    --dimension-offset: calc(100% + 25px);
    --tick: 9px;
    position: absolute;
    display: none;
    pointer-events: none;
    border: 0 solid var(--border-strong);
  }

  .dimension::before {
    content: '';
    position: absolute;
    background: var(--border-strong);
  }

  .vertical {
    top: 0;
    width: var(--tick);
    border-block-width: 1px;
  }

  .vertical::before {
    top: 0;
    bottom: 0;
    left: calc(50% - 0.5px);
    width: 1px;
  }

  .vertical.left {
    right: var(--dimension-offset);
  }

  .vertical.right {
    left: var(--dimension-offset);
  }

  .horizontal {
    bottom: var(--dimension-offset);
    height: var(--tick);
    border-inline-width: 1px;
  }

  .horizontal::before {
    left: 0;
    right: 0;
    top: calc(50% - 0.5px);
    height: 1px;
  }

  .horizontal.left {
    left: 0;
  }

  .horizontal.right {
    right: 0;
  }

  .dimension-label {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    padding: 2px 0;
    background: var(--bg);
    font-size: 11px;
    line-height: 1;
    color: var(--text-faint);
    white-space: nowrap;
  }

  @media (min-width: 1320px) {
    .dimension {
      display: block;
    }
  }
</style>
