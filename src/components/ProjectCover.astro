---
import { Picture, getImage } from 'astro:assets';
import Play from '@lucide/astro/icons/play';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';
import CoverPlaceholder from './CoverPlaceholder.astro';

interface Props extends HTMLAttributes<'div'> {
  cover?: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  loading?: 'lazy' | 'eager';
  video?: string;
}

const { cover, alt, widths, sizes, loading = 'lazy', video, ...rest } = Astro.props;
const source = video?.trim() || undefined;
const videoType = source?.toLowerCase().split('?')[0].endsWith('.webm') ? 'video/webm' : 'video/mp4';
const poster = source && cover ? (await getImage({ src: cover, width: 800, format: 'webp', quality: 85 })).src : undefined;
---

<div class="cover" {...rest}>
  {
    source ? (
      <>
        <video class="video" muted loop playsinline preload="none" poster={poster} aria-label={alt} data-preview-video>
          <source src={source} type={videoType} />
        </video>
        <span class="badge mono" aria-hidden="true">
          <span class="badge-idle">
            <Play aria-hidden="true" />
            prévia
          </span>
          <span class="badge-playing">
            <span class="badge-dot" />
            reproduzindo
          </span>
        </span>
      </>
    ) : cover ? (
      <Picture
        src={cover}
        alt={alt}
        widths={widths}
        sizes={sizes}
        formats={['avif', 'webp']}
        quality={90}
        loading={loading}
      />
    ) : (
      <CoverPlaceholder />
    )
  }
</div>

<style>
  .cover {
    position: relative;
    aspect-ratio: 16 / 10;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .cover :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cover :global(img),
  .video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .badge {
    position: absolute;
    top: 8px;
    left: 8px;
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 0 8px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: color-mix(in oklab, var(--bg) 82%, transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: var(--text-muted);
    font-size: 11px;
    line-height: 1;
  }

  .badge-idle,
  .badge-playing {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .badge-idle :global(svg) {
    width: 10px;
    height: 10px;
    fill: currentColor;
  }

  .badge-playing {
    display: none;
    color: var(--accent);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  :global([data-playing]) .badge-idle {
    display: none;
  }

  :global([data-playing]) .badge-playing {
    display: inline-flex;
  }

  :global([data-playing]) .badge {
    border-color: color-mix(in oklab, var(--accent) 50%, transparent);
  }
</style>
