---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CoverPlaceholder from './CoverPlaceholder.astro';

interface Props {
  cover?: ImageMetadata;
  alt: string;
  ratio?: string;
  widths: number[];
  sizes: string;
  loading?: 'lazy' | 'eager';
}

const { cover, alt, ratio = '16 / 10', widths, sizes, loading = 'lazy' } = Astro.props;
---

<div class="cover" style={`--ratio: ${ratio}`}>
  {
    cover ? (
      <Image src={cover} alt={alt} widths={widths} sizes={sizes} loading={loading} />
    ) : (
      <CoverPlaceholder />
    )
  }
</div>

<style>
  .cover {
    aspect-ratio: var(--ratio);
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
</style>
