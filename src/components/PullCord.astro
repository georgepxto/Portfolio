<div class="pull-cord is-hinting" data-pull-cord>
  <div class="sway">
    <div class="swing" data-cord-swing>
      <span class="line" aria-hidden="true" data-cord-line></span>
      <button
        class="handle"
        type="button"
        role="switch"
        aria-checked="false"
        aria-label="Modo claro"
        data-cord-handle
      >
        <span class="pill" data-cord-pill>
          <span class="dot"></span>
        </span>
        <span class="hint mono" aria-hidden="true">
          <span class="hint-on">puxe para acender</span>
          <span class="hint-off">puxe para apagar</span>
        </span>
      </button>
    </div>
  </div>
  <span class="mount" aria-hidden="true"></span>
</div>

<style>
  .pull-cord {
    position: absolute;
    top: 100%;
    right: var(--cord-right, 26px);
    z-index: 1;
    width: 44px;
    height: 120px;
    pointer-events: none;
    --cord: 56px;
    view-transition-name: pull-cord;
    transition: opacity 0.25s ease, visibility 0.25s;
  }

  :global(html:not(.js)) .pull-cord {
    display: none;
  }

  .sway,
  .swing {
    position: absolute;
    inset: 0;
    transform-origin: 50% 4px;
  }

  .sway {
    animation: cord-sway 5s ease-in-out infinite;
  }

  .pull-cord.is-active .sway {
    animation-play-state: paused;
  }

  @keyframes cord-sway {
    0%,
    100% {
      transform: rotate(-1.2deg);
    }
    50% {
      transform: rotate(1.2deg);
    }
  }

  .mount {
    position: absolute;
    top: 0;
    left: 50%;
    width: 12px;
    height: 5px;
    z-index: 1;
    margin-left: -6px;
    border-radius: 0 0 3px 3px;
    background: var(--border-strong);
  }

  .line {
    position: absolute;
    top: 4px;
    left: 50%;
    width: 1.5px;
    height: var(--cord);
    margin-left: -0.75px;
    background: var(--text-faint);
  }

  .handle {
    position: absolute;
    top: calc(var(--cord) - 5px);
    left: 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    pointer-events: auto;
  }

  .pull-cord.is-active .handle {
    cursor: grabbing;
  }

  .handle:focus-visible {
    outline: none;
  }

  .pill {
    position: relative;
    width: 16px;
    height: 26px;
    border-radius: 8px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.18);
    transition: border-color 0.15s ease;
  }

  .handle:hover .pill,
  .handle.is-armed .pill {
    border-color: var(--text-faint);
  }

  .handle:focus-visible .pill {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .dot {
    position: absolute;
    bottom: 5px;
    left: 50%;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow:
      0 0 2px var(--accent),
      0 0 7px color-mix(in oklab, var(--accent) 70%, transparent);
  }

  .handle.is-armed .dot {
    box-shadow:
      0 0 3px var(--accent),
      0 0 10px color-mix(in oklab, var(--accent) 85%, transparent);
  }

  :global(:root[data-theme='light']) .dot {
    background: var(--text-faint);
    box-shadow: none;
  }

  .hint {
    position: absolute;
    top: 50%;
    right: calc(100% - 6px);
    font-size: 11px;
    line-height: 1;
    color: var(--text-faint);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(4px, -50%);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .pull-cord.is-hinting .hint,
  .handle:hover .hint,
  .handle:focus-visible .hint {
    opacity: 1;
    transform: translate(0, -50%);
  }

  .pull-cord.is-active .hint {
    opacity: 0;
  }

  .hint-off,
  :global(:root[data-theme='light']) .hint-on {
    display: none;
  }

  :global(:root[data-theme='light']) .hint-off {
    display: inline;
  }

  @media (prefers-reduced-motion: reduce) {
    .sway {
      animation: none;
    }

    .hint {
      transition: opacity 0.3s ease;
    }
  }

  @media (max-width: 640px) {
    .pull-cord {
      height: 90px;
      --cord: 28px;
    }

    .hint {
      display: none;
    }
  }
</style>

<script>
  type Theme = 'dark' | 'light';

  const MAX = 46;
  const ARM = 18;
  const TAP = 4;
  const SPRING_EASE = 'cubic-bezier(.37, 0, .63, 1)';
  const MAX_ANGLE = 38;
  const STIFFNESS = 103;
  const DAMPING = 2.4;
  const KICK = 72;
  const MAX_SPEED = 420;

  const root = document.documentElement;
  const wrapper = document.querySelector<HTMLElement>('[data-pull-cord]');
  const swing = wrapper?.querySelector<HTMLElement>('[data-cord-swing]');
  const line = wrapper?.querySelector<HTMLElement>('[data-cord-line]');
  const handle = wrapper?.querySelector<HTMLButtonElement>('[data-cord-handle]');
  const pill = wrapper?.querySelector<HTMLElement>('[data-cord-pill]');

  if (wrapper && swing && line && handle && pill) {
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const systemLight = matchMedia('(prefers-color-scheme: light)');
    const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

    let audio: AudioContext | undefined;
    let motion: Animation[] = [];
    let transition: ViewTransition | undefined;
    let suppressClick = false;
    let angle = 0;
    let velocity = 0;
    let frame = 0;
    let last = 0;
    let drag: {
      id: number;
      x: number;
      y: number;
      moved: boolean;
      armed: boolean;
      eff: number;
      offset: number;
      radius: number;
      samples: { angle: number; time: number }[];
    } | null = null;

    const clamp = (value: number, limit: number) => Math.max(-limit, Math.min(limit, value));

    const current = (): Theme => (root.dataset.theme === 'light' ? 'light' : 'dark');

    const sync = () => {
      handle.setAttribute('aria-checked', String(current() === 'light'));
      const bg = getComputedStyle(root).getPropertyValue('--bg').trim();
      if (themeColor && bg) themeColor.content = bg;
    };

    const apply = (theme: Theme, persist: boolean) => {
      root.dataset.theme = theme;
      if (persist) {
        try {
          localStorage.setItem('theme', theme);
        } catch {}
      }
      sync();
    };

    const saved = () => {
      try {
        const value = localStorage.getItem('theme');
        return value === 'light' || value === 'dark' ? value : null;
      } catch {
        return null;
      }
    };

    const tone = (from: number, to: number, gain = 0.05, duration = 0.05) => {
      try {
        audio ??= new AudioContext();
        if (audio.state === 'suspended') void audio.resume();
        const start = audio.currentTime;
        const osc = audio.createOscillator();
        const volume = audio.createGain();
        osc.type = 'square';
        osc.frequency.setValueAtTime(from, start);
        osc.frequency.exponentialRampToValueAtTime(to, start + duration);
        volume.gain.setValueAtTime(gain, start);
        volume.gain.exponentialRampToValueAtTime(0.0001, start + duration);
        osc.connect(volume).connect(audio.destination);
        osc.start(start);
        osc.stop(start + duration);
      } catch {}
    };

    const origin = () => {
      const rect = pill.getBoundingClientRect();
      return { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
    };

    const switchTheme = (point: { x: number; y: number }) => {
      const next: Theme = current() === 'light' ? 'dark' : 'light';
      if (next === 'light') tone(2400, 700);
      else tone(1500, 300);

      if (typeof document.startViewTransition !== 'function' || reducedMotion.matches) {
        apply(next, true);
        return;
      }

      root.dataset.vt = next;
      const vt = document.startViewTransition(() => apply(next, true));
      transition = vt;

      vt.ready
        .then(() => {
          const { x, y } = point;
          const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
          const closed = `circle(0px at ${x}px ${y}px)`;
          const open = `circle(${radius}px at ${x}px ${y}px)`;
          const lighting = next === 'light';
          root.animate(
            { clipPath: lighting ? [closed, open] : [open, closed] },
            {
              duration: lighting ? 800 : 560,
              easing: lighting ? 'cubic-bezier(.55, 0, .2, 1)' : 'cubic-bezier(.6, 0, .85, .35)',
              fill: 'forwards',
              pseudoElement: lighting ? '::view-transition-new(root)' : '::view-transition-old(root)',
            },
          );
        })
        .catch(() => {});

      vt.finished.finally(() => {
        if (transition !== vt) return;
        transition = undefined;
        delete root.dataset.vt;
      });
    };

    const rest = () => parseFloat(getComputedStyle(wrapper).getPropertyValue('--cord')) || 56;

    const setPull = (offset: number) => {
      line.style.height = offset ? `${rest() + offset}px` : '';
      handle.style.transform = offset ? `translateY(${offset}px)` : '';
    };

    const stopMotion = () => {
      motion.forEach((animation) => animation.cancel());
      motion = [];
    };

    const render = () => {
      swing.style.transform = angle ? `rotate(${angle}deg)` : '';
    };

    const step = (time: number) => {
      const dt = Math.min(0.032, Math.max(0, time - last) / 1000);
      last = time;
      velocity += (-STIFFNESS * angle - DAMPING * velocity) * dt;
      angle += velocity * dt;

      if (Math.abs(angle) < 0.02 && Math.abs(velocity) < 0.5) {
        angle = 0;
        velocity = 0;
        frame = 0;
        render();
        return;
      }

      render();
      frame = requestAnimationFrame(step);
    };

    const swingFree = () => {
      if (frame || drag) return;
      last = performance.now();
      frame = requestAnimationFrame(step);
    };

    const holdSwing = () => {
      cancelAnimationFrame(frame);
      frame = 0;
    };

    const kick = () => {
      if (reducedMotion.matches || drag) return;
      velocity += KICK * (Math.random() < 0.5 ? -1 : 1);
      swingFree();
    };

    const polar = (event: PointerEvent) => {
      const rect = wrapper.getBoundingClientRect();
      const px = event.clientX - (rect.left + rect.width / 2);
      const py = Math.max(event.clientY - rect.top - 4, 1);
      return { angle: (-Math.atan2(px, py) * 180) / Math.PI, radius: Math.hypot(px, py) };
    };

    const releaseSpeed = (samples: { angle: number; time: number }[], now: number) => {
      const recent = samples.filter((sample) => now - sample.time <= 100);
      if (recent.length < 2) return 0;
      const first = recent[0];
      const latest = recent[recent.length - 1];
      const elapsed = (latest.time - first.time) / 1000;
      return elapsed > 0 ? clamp((latest.angle - first.angle) / elapsed, MAX_SPEED) : 0;
    };

    const spring = (values: number[], duration: number, after?: () => void) => {
      stopMotion();
      setPull(0);
      const base = rest();
      motion = [
        line.animate(
          values.map((value) => ({ height: `${base + value}px`, easing: SPRING_EASE })),
          duration,
        ),
        handle.animate(
          values.map((value) => ({ transform: `translateY(${value}px)`, easing: SPRING_EASE })),
          duration,
        ),
      ];
      if (after) motion[1].finished.then(after).catch(() => {});
    };

    const setArmed = (armed: boolean) => {
      if (!drag || drag.armed === armed) return;
      drag.armed = armed;
      handle.classList.toggle('is-armed', armed);
      if (armed) tone(900, 220, 0.03, 0.03);
    };

    const endDrag = (event: PointerEvent, commit: boolean) => {
      if (!drag || event.pointerId !== drag.id) return;
      const ended = drag;
      drag = null;
      wrapper.classList.remove('is-active');
      handle.classList.remove('is-armed');
      if (handle.hasPointerCapture(event.pointerId)) handle.releasePointerCapture(event.pointerId);
      if (!ended.moved) {
        if (angle) swingFree();
        return;
      }

      suppressClick = true;
      if (commit && ended.armed) switchTheme(origin());

      if (reducedMotion.matches) {
        setPull(0);
        angle = 0;
        velocity = 0;
        render();
        return;
      }

      velocity = releaseSpeed(ended.samples, event.timeStamp);
      const swinging = Math.abs(angle) > 1 || Math.abs(velocity) > 20;

      if (ended.eff > 1) spring([ended.eff, -8, 3.5, -1.2, 0], 560, swinging ? undefined : kick);
      else setPull(0);

      if (swinging) swingFree();
    };

    handle.addEventListener('pointerdown', (event) => {
      if (event.button !== 0 || drag) return;
      suppressClick = false;
      stopMotion();
      setPull(0);
      holdSwing();
      velocity = 0;
      const start = polar(event);
      drag = {
        id: event.pointerId,
        x: event.clientX,
        y: event.clientY,
        moved: false,
        armed: false,
        eff: 0,
        offset: angle - start.angle,
        radius: start.radius,
        samples: [{ angle, time: event.timeStamp }],
      };
      handle.setPointerCapture(event.pointerId);
      wrapper.classList.add('is-active');
    });

    handle.addEventListener('pointermove', (event) => {
      if (!drag) {
        if (event.pointerType === 'mouse' && !event.buttons && !reducedMotion.matches) {
          velocity = clamp(velocity - event.movementX * 4, 260);
          swingFree();
        }
        return;
      }

      if (event.pointerId !== drag.id) return;
      const dx = event.clientX - drag.x;
      const dy = event.clientY - drag.y;
      if (!drag.moved && Math.hypot(dx, dy) < TAP) return;
      drag.moved = true;

      const point = polar(event);
      angle = MAX_ANGLE * Math.tanh((point.angle + drag.offset) / MAX_ANGLE);
      render();
      drag.samples.push({ angle, time: event.timeStamp });
      if (drag.samples.length > 12) drag.samples.shift();

      const stretch = point.radius - drag.radius;
      drag.eff = stretch > 0 ? MAX * (1 - Math.exp(-stretch / MAX)) : 0;
      setPull(drag.eff);
      if (drag.eff > ARM) setArmed(true);
      else if (drag.eff < ARM - 4) setArmed(false);
    });

    handle.addEventListener('pointerup', (event) => endDrag(event, true));
    handle.addEventListener('pointercancel', (event) => endDrag(event, false));
    handle.addEventListener('lostpointercapture', (event) => endDrag(event, false));

    handle.addEventListener('click', () => {
      if (suppressClick) {
        suppressClick = false;
        return;
      }

      if (reducedMotion.matches) {
        switchTheme(origin());
        return;
      }

      spring([0, 26, -7, 3, -1, 0], 720, kick);
      window.setTimeout(() => switchTheme(origin()), 170);
    });

    systemLight.addEventListener('change', (event) => {
      if (!saved()) apply(event.matches ? 'light' : 'dark', false);
    });

    window.setTimeout(() => wrapper.classList.remove('is-hinting'), 5000);

    sync();
  }
</script>
