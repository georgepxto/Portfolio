<div class="pull-cord is-hinting" data-pull-cord>
  <div class="sway">
    <div class="swing" data-cord-swing>
      <span class="line" aria-hidden="true" data-cord-line></span>
      <button
        class="handle"
        type="button"
        role="switch"
        aria-checked="false"
        aria-label="Modo claro"
        data-cord-handle
      >
        <span class="tail" aria-hidden="true"></span>
        <span class="pill" data-cord-pill>
          <span class="dot"></span>
        </span>
        <span class="hint mono" aria-hidden="true">
          <span class="hint-on">puxe para acender</span>
          <span class="hint-off">puxe para apagar</span>
        </span>
      </button>
    </div>
  </div>
  <span class="mount" aria-hidden="true"></span>
</div>

<style>
  .pull-cord {
    position: absolute;
    top: 100%;
    right: var(--cord-right, 26px);
    z-index: 1;
    width: 44px;
    height: 120px;
    pointer-events: none;
    view-transition-name: pull-cord;
    transition: opacity 0.25s ease, visibility 0.25s;
  }

  :global(html:not(.js)) .pull-cord {
    display: none;
  }

  .sway,
  .swing {
    position: absolute;
    inset: 0;
    transform-origin: 50% 4px;
  }

  .sway {
    animation: cord-sway 5s ease-in-out infinite;
  }

  .pull-cord.is-active .sway {
    animation-play-state: paused;
  }

  @keyframes cord-sway {
    0%,
    100% {
      transform: rotate(-1.2deg);
    }
    50% {
      transform: rotate(1.2deg);
    }
  }

  .mount {
    position: absolute;
    top: 0;
    left: 50%;
    width: 12px;
    height: 5px;
    z-index: 1;
    margin-left: -6px;
    border-radius: 0 0 3px 3px;
    background: var(--border-strong);
  }

  .line {
    position: absolute;
    top: 4px;
    left: 50%;
    width: 1.5px;
    height: var(--cord);
    margin-left: -0.75px;
    background: var(--text-faint);
    background: color-mix(in oklab, var(--text-faint), var(--accent) calc(var(--strain, 0) * 85%));
  }

  .tail {
    position: absolute;
    bottom: calc(50% + 13px);
    left: 50%;
    display: none;
    width: 1.5px;
    height: var(--tail, 0px);
    margin-left: -0.75px;
    background: var(--text-faint);
  }

  .pull-cord.is-broken .tail {
    display: block;
  }

  .pull-cord.is-broken .handle {
    pointer-events: none;
  }

  .handle {
    position: absolute;
    top: calc(var(--cord) - 5px);
    left: 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    pointer-events: auto;
  }

  .pull-cord.is-active .handle {
    cursor: grabbing;
  }

  .handle:focus-visible {
    outline: none;
  }

  .pill {
    position: relative;
    width: 16px;
    height: 26px;
    border-radius: 8px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.18);
    transition: border-color 0.15s ease;
  }

  .handle:hover .pill,
  .handle.is-armed .pill {
    border-color: var(--text-faint);
  }

  .handle:focus-visible .pill {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .dot {
    position: absolute;
    bottom: 5px;
    left: 50%;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow:
      0 0 2px var(--accent),
      0 0 7px color-mix(in oklab, var(--accent) 70%, transparent);
  }

  .handle.is-armed .dot {
    box-shadow:
      0 0 3px var(--accent),
      0 0 10px color-mix(in oklab, var(--accent) 85%, transparent);
  }

  :global(:root[data-theme='light']) .dot {
    background: var(--text-faint);
    box-shadow: none;
  }

  .hint {
    position: absolute;
    top: 50%;
    right: calc(100% - 6px);
    font-size: 11px;
    line-height: 1;
    color: var(--text-faint);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(4px, -50%);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .pull-cord.is-hinting .hint,
  .handle:hover .hint,
  .handle:focus-visible .hint {
    opacity: 1;
    transform: translate(0, -50%);
  }

  .pull-cord.is-active .hint,
  .pull-cord.is-broken .hint,
  .pull-cord:not(.is-pulled) .hint {
    opacity: 0;
  }

  .hint-off,
  :global(:root[data-theme='light']) .hint-on {
    display: none;
  }

  :global(:root[data-theme='light']) .hint-off {
    display: inline;
  }

  @media (min-width: 1540px) {
    .hint {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sway {
      animation: none;
    }

    .handle {
      transition: opacity 0.2s ease;
    }

    .pull-cord.is-broken .handle {
      opacity: 0;
    }

    .hint {
      transition: opacity 0.3s ease;
    }
  }

  @media (max-width: 640px) {
    .pull-cord {
      height: 90px;
    }

    .hint {
      display: none;
    }
  }
</style>

<script>
  import { onElement } from '../scripts/page';

  type Theme = 'dark' | 'light';

  const MAX = 46;
  const ARM = 18;
  const TAP = 4;
  const SPRING_EASE = 'cubic-bezier(.37, 0, .63, 1)';
  const MAX_ANGLE = 38;
  const STIFFNESS = 103;
  const DAMPING = 2.4;
  const KICK = 72;
  const MAX_SPEED = 420;
  const REVEAL = 680;
  const REVEAL_STEPS = 24;
  const STRAIN_AFTER = 700;
  const BREAK_AFTER = 1900;
  const FALL = 950;
  const FALL_STEPS = 12;
  const RESPAWN_DELAY = 350;
  const DROP = 900;
  const GRAVITY_EASE = 'cubic-bezier(.5, 0, .9, .55)';

  const coverage = (t: number) => (1 - Math.cos(Math.PI * t)) / 2;

  const root = document.documentElement;

  onElement<HTMLElement>('[data-pull-cord]', (wrapper, signal) => {
    const swing = wrapper.querySelector<HTMLElement>('[data-cord-swing]');
    const line = wrapper.querySelector<HTMLElement>('[data-cord-line]');
    const handle = wrapper.querySelector<HTMLButtonElement>('[data-cord-handle]');
    const pill = wrapper.querySelector<HTMLElement>('[data-cord-pill]');
    if (!swing || !line || !handle || !pill) return;

    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const systemLight = matchMedia('(prefers-color-scheme: light)');

    let audio: AudioContext | undefined;
    let motion: Animation[] = [];
    let transition: ViewTransition | undefined;
    let reveal: Animation | undefined;
    let suppressClick = false;
    let broken = false;
    let strainFrame = 0;
    let armedAt = 0;
    let lastCreak = 0;
    let shake = { x: 0, y: 0 };
    let tremor = 0;
    let respawnTimer = 0;
    let angle = 0;
    let velocity = 0;
    let frame = 0;
    let last = 0;
    let drag: {
      id: number;
      x: number;
      y: number;
      moved: boolean;
      armed: boolean;
      eff: number;
      offset: number;
      radius: number;
      samples: { angle: number; time: number }[];
    } | null = null;

    const clamp = (value: number, limit: number) => Math.max(-limit, Math.min(limit, value));

    const current = (): Theme => (root.dataset.theme === 'light' ? 'light' : 'dark');

    const sync = () => {
      handle.setAttribute('aria-checked', String(current() === 'light'));
      const bg = getComputedStyle(root).getPropertyValue('--bg').trim();
      const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
      if (themeColor && bg) themeColor.content = bg;
    };

    const apply = (theme: Theme, persist: boolean) => {
      root.dataset.theme = theme;
      if (persist) {
        try {
          localStorage.setItem('theme', theme);
        } catch {}
      }
      sync();
    };

    const saved = () => {
      try {
        const value = localStorage.getItem('theme');
        return value === 'light' || value === 'dark' ? value : null;
      } catch {
        return null;
      }
    };

    const tone = (from: number, to: number, gain = 0.05, duration = 0.05) => {
      try {
        audio ??= new AudioContext();
        if (audio.state === 'suspended') void audio.resume();
        const start = audio.currentTime;
        const osc = audio.createOscillator();
        const volume = audio.createGain();
        osc.type = 'square';
        osc.frequency.setValueAtTime(from, start);
        osc.frequency.exponentialRampToValueAtTime(to, start + duration);
        volume.gain.setValueAtTime(gain, start);
        volume.gain.exponentialRampToValueAtTime(0.0001, start + duration);
        osc.connect(volume).connect(audio.destination);
        osc.start(start);
        osc.stop(start + duration);
      } catch {}
    };

    const crack = () => {
      try {
        audio ??= new AudioContext();
        if (audio.state === 'suspended') void audio.resume();
        const length = Math.round(audio.sampleRate * 0.09);
        const buffer = audio.createBuffer(1, length, audio.sampleRate);
        const data = buffer.getChannelData(0);
        for (let index = 0; index < length; index++) data[index] = (Math.random() * 2 - 1) * (1 - index / length) ** 3;
        const source = audio.createBufferSource();
        const filter = audio.createBiquadFilter();
        const volume = audio.createGain();
        source.buffer = buffer;
        filter.type = 'highpass';
        filter.frequency.value = 1400;
        volume.gain.value = 0.22;
        source.connect(filter).connect(volume).connect(audio.destination);
        source.start(audio.currentTime);
      } catch {}
    };

    const origin = () => {
      const rect = pill.getBoundingClientRect();
      return { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
    };

    const switchTheme = (point: { x: number; y: number }) => {
      if (transition) return;
      document.querySelector('[data-cord-note]')?.classList.add('is-dismissed');
      wrapper.classList.add('is-pulled');
      document.dispatchEvent(new CustomEvent('cord:pull'));
      const next: Theme = current() === 'light' ? 'dark' : 'light';
      if (next === 'light') tone(2400, 700);
      else tone(1500, 300);

      if (typeof document.startViewTransition !== 'function' || reducedMotion.matches) {
        apply(next, true);
        return;
      }

      reveal?.cancel();
      reveal = undefined;
      root.dataset.vt = next;
      const vt = document.startViewTransition(() => apply(next, true));
      transition = vt;
      let animation: Animation | undefined;

      vt.ready
        .then(() => {
          const { x, y } = point;
          const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
          const lighting = next === 'light';
          const frames = Array.from({ length: REVEAL_STEPS + 1 }, (_, index) => {
            const t = index / REVEAL_STEPS;
            const area = lighting ? coverage(t) : 1 - coverage(t);
            return { offset: t, clipPath: `circle(${(radius * Math.sqrt(area)).toFixed(1)}px at ${x}px ${y}px)` };
          });
          animation = root.animate(frames, {
            duration: REVEAL,
            fill: 'forwards',
            pseudoElement: lighting ? '::view-transition-new(root)' : '::view-transition-old(root)',
          });
          reveal = animation;
        })
        .catch(() => {});

      vt.finished.finally(() => {
        animation?.cancel();
        if (reveal === animation) reveal = undefined;
        if (transition !== vt) return;
        transition = undefined;
        delete root.dataset.vt;
      });
    };

    const rest = () => parseFloat(getComputedStyle(wrapper).getPropertyValue('--cord')) || 56;

    const setPull = (offset: number) => {
      line.style.height = offset ? `${rest() + offset}px` : '';
      handle.style.transform = offset || shake.x || shake.y ? `translate(${shake.x}px, ${offset + shake.y}px)` : '';
    };

    const stopMotion = () => {
      motion.forEach((animation) => animation.cancel());
      motion = [];
    };

    const render = () => {
      const shown = angle + tremor;
      swing.style.transform = shown ? `rotate(${shown}deg)` : '';
    };

    const step = (time: number) => {
      const dt = Math.min(0.032, Math.max(0, time - last) / 1000);
      last = time;
      velocity += (-STIFFNESS * angle - DAMPING * velocity) * dt;
      angle += velocity * dt;

      if (Math.abs(angle) < 0.02 && Math.abs(velocity) < 0.5) {
        angle = 0;
        velocity = 0;
        frame = 0;
        render();
        return;
      }

      render();
      frame = requestAnimationFrame(step);
    };

    const swingFree = () => {
      if (frame || drag) return;
      last = performance.now();
      frame = requestAnimationFrame(step);
    };

    const holdSwing = () => {
      cancelAnimationFrame(frame);
      frame = 0;
    };

    const kick = () => {
      if (reducedMotion.matches || drag) return;
      velocity += KICK * (Math.random() < 0.5 ? -1 : 1);
      swingFree();
    };

    const polar = (event: PointerEvent) => {
      const rect = wrapper.getBoundingClientRect();
      const px = event.clientX - (rect.left + rect.width / 2);
      const py = Math.max(event.clientY - rect.top - 4, 1);
      return { angle: (-Math.atan2(px, py) * 180) / Math.PI, radius: Math.hypot(px, py) };
    };

    const releaseSpeed = (samples: { angle: number; time: number }[], now: number) => {
      const recent = samples.filter((sample) => now - sample.time <= 100);
      if (recent.length < 2) return 0;
      const first = recent[0];
      const latest = recent[recent.length - 1];
      const elapsed = (latest.time - first.time) / 1000;
      return elapsed > 0 ? clamp((latest.angle - first.angle) / elapsed, MAX_SPEED) : 0;
    };

    const spring = (values: number[], duration: number, after?: () => void) => {
      stopMotion();
      setPull(0);
      const base = rest();
      motion = [
        line.animate(
          values.map((value) => ({ height: `${base + value}px`, easing: SPRING_EASE })),
          duration,
        ),
        handle.animate(
          values.map((value) => ({ transform: `translateY(${value}px)`, easing: SPRING_EASE })),
          duration,
        ),
      ];
      if (after) motion[1].finished.then(after).catch(() => {});
    };

    const stopStrain = () => {
      cancelAnimationFrame(strainFrame);
      strainFrame = 0;
      shake = { x: 0, y: 0 };
      tremor = 0;
      render();
      wrapper.style.removeProperty('--strain');
    };

    const strainStep = () => {
      strainFrame = 0;
      if (!drag?.armed) return;
      const time = performance.now();
      const held = time - armedAt;
      if (held >= BREAK_AFTER) {
        snap();
        return;
      }

      const strain = Math.max(0, (held - STRAIN_AFTER) / (BREAK_AFTER - STRAIN_AFTER));
      wrapper.style.setProperty('--strain', strain.toFixed(3));
      const amount = reducedMotion.matches ? 0 : strain ** 1.4 * 3.6;
      shake = { x: (Math.random() * 2 - 1) * amount, y: (Math.random() * 2 - 1) * amount * 0.6 };
      tremor = (Math.random() * 2 - 1) * amount * 0.5;
      setPull(drag.eff);
      render();
      if (strain > 0 && time - lastCreak > 260 - 170 * strain) {
        lastCreak = time;
        tone(150 + 130 * strain, 90, 0.01 + 0.02 * strain, 0.025);
      }
      strainFrame = requestAnimationFrame(strainStep);
    };

    const setArmed = (armed: boolean) => {
      if (!drag || drag.armed === armed) return;
      drag.armed = armed;
      handle.classList.toggle('is-armed', armed);
      if (armed) {
        tone(900, 220, 0.03, 0.03);
        armedAt = performance.now();
        lastCreak = 0;
        if (!strainFrame) strainFrame = requestAnimationFrame(strainStep);
      } else {
        stopStrain();
        setPull(drag.eff);
      }
    };

    const respawn = () => {
      respawnTimer = 0;
      stopMotion();
      handle.style.removeProperty('--tail');
      setPull(0);
      holdSwing();
      angle = 0;
      velocity = 0;
      render();

      if (reducedMotion.matches) {
        broken = false;
        wrapper.classList.remove('is-broken');
        return;
      }

      const base = rest();
      const drop = [-base, 12, -5, 2, 0];
      const offsets = [0, 0.5, 0.7, 0.86, 1];
      const easings = [GRAVITY_EASE, SPRING_EASE, SPRING_EASE, SPRING_EASE, SPRING_EASE];
      broken = false;
      motion = [
        line.animate(
          drop.map((value, index) => ({ height: `${base + value}px`, offset: offsets[index], easing: easings[index] })),
          DROP,
        ),
        handle.animate(
          drop.map((value, index) => ({
            transform: `translateY(${value}px)`,
            opacity: index === 0 ? 0 : 1,
            offset: offsets[index],
            easing: easings[index],
          })),
          DROP,
        ),
      ];
      wrapper.classList.remove('is-broken');
      tone(500, 900, 0.02, 0.04);
      motion[1].finished
        .then(() => {
          velocity += 34 * (Math.random() < 0.5 ? -1 : 1);
          swingFree();
        })
        .catch(() => {});
    };

    const snap = () => {
      if (!drag) return;
      const ended = drag;
      drag = null;
      broken = true;
      suppressClick = true;
      stopStrain();
      holdSwing();
      stopMotion();
      wrapper.classList.remove('is-active');
      handle.classList.remove('is-armed');
      wrapper.classList.add('is-broken');
      if (handle.hasPointerCapture(ended.id)) handle.releasePointerCapture(ended.id);

      crack();
      switchTheme(origin());

      if (reducedMotion.matches) {
        setPull(0);
        respawnTimer = window.setTimeout(respawn, 700);
        return;
      }

      const length = rest() + ended.eff;
      const stub = Math.round(length * 0.42);
      handle.style.setProperty('--tail', `${Math.round(length - stub)}px`);
      setPull(0);

      const theta = (angle * Math.PI) / 180;
      const direction = Math.sign(angle) || (Math.random() < 0.5 ? -1 : 1);
      const spin = direction * (110 + Math.random() * 70);
      const local = (x: number, y: number) => ({
        x: x * Math.cos(theta) + y * Math.sin(theta),
        y: -x * Math.sin(theta) + y * Math.cos(theta),
      });

      motion = [
        line.animate(
          [
            { height: `${stub}px`, easing: 'cubic-bezier(.2, .8, .3, 1)' },
            { height: '4px', offset: 0.4, easing: SPRING_EASE },
            { height: '13px', offset: 0.65, easing: SPRING_EASE },
            { height: '8px', offset: 0.85, easing: SPRING_EASE },
            { height: '10px' },
          ],
          { duration: 700, fill: 'forwards' },
        ),
        handle.animate(
          Array.from({ length: FALL_STEPS + 1 }, (_, index) => {
            const t = index / FALL_STEPS;
            const point = local(direction * 46 * t, 460 * t * t - 18 * t);
            return {
              offset: t,
              transform: `translate(${point.x.toFixed(1)}px, ${(ended.eff + point.y).toFixed(1)}px) rotate(${(spin * t * t).toFixed(1)}deg)`,
              opacity: t < 0.55 ? 1 : 1 - (t - 0.55) / 0.45,
            };
          }),
          { duration: FALL, fill: 'forwards' },
        ),
      ];

      motion[1].finished
        .then(() => {
          swingFree();
          respawnTimer = window.setTimeout(respawn, RESPAWN_DELAY);
        })
        .catch(() => {});
    };

    const endDrag = (event: PointerEvent, commit: boolean) => {
      if (!drag || event.pointerId !== drag.id) return;
      const ended = drag;
      drag = null;
      stopStrain();
      wrapper.classList.remove('is-active');
      handle.classList.remove('is-armed');
      if (handle.hasPointerCapture(event.pointerId)) handle.releasePointerCapture(event.pointerId);
      if (!ended.moved) {
        if (angle) swingFree();
        return;
      }

      suppressClick = true;
      if (commit && ended.armed) switchTheme(origin());

      if (reducedMotion.matches) {
        setPull(0);
        angle = 0;
        velocity = 0;
        render();
        return;
      }

      velocity = releaseSpeed(ended.samples, event.timeStamp);
      const swinging = Math.abs(angle) > 1 || Math.abs(velocity) > 20;

      if (ended.eff > 1) spring([ended.eff, -8, 3.5, -1.2, 0], 560, swinging ? undefined : kick);
      else setPull(0);

      if (swinging) swingFree();
    };

    handle.addEventListener('pointerdown', (event) => {
      if (event.button !== 0 || drag || broken) return;
      suppressClick = false;
      stopMotion();
      setPull(0);
      holdSwing();
      velocity = 0;
      const start = polar(event);
      drag = {
        id: event.pointerId,
        x: event.clientX,
        y: event.clientY,
        moved: false,
        armed: false,
        eff: 0,
        offset: angle - start.angle,
        radius: start.radius,
        samples: [{ angle, time: event.timeStamp }],
      };
      handle.setPointerCapture(event.pointerId);
      wrapper.classList.add('is-active');
    }, { signal });

    handle.addEventListener('pointermove', (event) => {
      if (!drag) {
        if (event.pointerType === 'mouse' && !event.buttons && !reducedMotion.matches) {
          velocity = clamp(velocity - event.movementX * 4, 260);
          swingFree();
        }
        return;
      }

      if (event.pointerId !== drag.id) return;
      const dx = event.clientX - drag.x;
      const dy = event.clientY - drag.y;
      if (!drag.moved && Math.hypot(dx, dy) < TAP) return;
      drag.moved = true;

      const point = polar(event);
      angle = MAX_ANGLE * Math.tanh((point.angle + drag.offset) / MAX_ANGLE);
      render();
      drag.samples.push({ angle, time: event.timeStamp });
      if (drag.samples.length > 12) drag.samples.shift();

      const stretch = point.radius - drag.radius;
      drag.eff = stretch > 0 ? MAX * (1 - Math.exp(-stretch / MAX)) : 0;
      setPull(drag.eff);
      if (drag.eff > ARM) setArmed(true);
      else if (drag.eff < ARM - 4) setArmed(false);
    }, { signal });

    handle.addEventListener('pointerup', (event) => endDrag(event, true), { signal });
    handle.addEventListener('pointercancel', (event) => endDrag(event, false), { signal });
    handle.addEventListener('lostpointercapture', (event) => endDrag(event, false), { signal });

    handle.addEventListener('click', () => {
      if (suppressClick) {
        suppressClick = false;
        return;
      }
      if (broken || transition) return;

      if (reducedMotion.matches) {
        switchTheme(origin());
        return;
      }

      spring([0, 26, -7, 3, -1, 0], 720, kick);
      window.setTimeout(() => switchTheme(origin()), 170);
    }, { signal });

    systemLight.addEventListener(
      'change',
      (event) => {
        if (!saved()) apply(event.matches ? 'light' : 'dark', false);
      },
      { signal },
    );

    const hint = window.setTimeout(() => wrapper.classList.remove('is-hinting'), 5000);

    sync();

    return () => {
      window.clearTimeout(hint);
      window.clearTimeout(respawnTimer);
      cancelAnimationFrame(frame);
      stopStrain();
      stopMotion();
    };
  });
</script>
