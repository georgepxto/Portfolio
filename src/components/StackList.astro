---
import type { StackGroup } from '../data/stack';

interface Props {
  groups: StackGroup[];
}

const { groups } = Astro.props;
---

<ul class="stack" role="list" data-reveal>
  {
    groups.map((group) => (
      <li class="group">
        <span class="label mono">{group.label}</span>
        <span class="items">{group.items.join(', ')}</span>
      </li>
    ))
  }
</ul>

<style>
  .stack {
    --columns: 4;
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    padding: 22px 24px 24px;
    border-bottom: 1px solid var(--border);
  }

  .group:nth-child(4n + 1) {
    padding-left: 0;
  }

  .group:not(:nth-child(4n + 1)) {
    border-left: 1px solid var(--border);
  }

  .label {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .items {
    font-size: clamp(17px, 1.4vw, 20px);
    font-weight: 500;
    line-height: 1.45;
    color: var(--text);
  }

  @media (max-width: 1000px) {
    .stack {
      --columns: 2;
    }

    .group:nth-child(n) {
      padding-left: 24px;
      border-left: 1px solid var(--border);
    }

    .group:nth-child(2n + 1) {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 760px) {
    .stack {
      --columns: 1;
    }

    .group:nth-child(n) {
      padding: 18px 0;
      border-left: 0;
    }
  }
</style>
