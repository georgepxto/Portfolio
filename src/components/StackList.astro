---
import GridRow from './GridRow.astro';
import type { StackGroup } from '../data/stack';

interface Props {
  groups: StackGroup[];
}

const { groups } = Astro.props;
---

<ul class="stack" role="list" data-reveal>
  {
    groups.map((group) => (
      <GridRow as="li">
        <div class="row">
          <span class="label mono">{group.label}</span>
          <span class="items">{group.items.join(', ')}</span>
        </div>
      </GridRow>
    ))
  }
</ul>

<style>
  .row {
    display: flex;
  }

  .label {
    flex: none;
    width: 160px;
    padding: 14px 16px;
    border-right: 1px solid var(--border);
    font-size: 12px;
    line-height: 2;
    color: var(--text-faint);
  }

  .items {
    flex: 1;
    min-width: 0;
    padding: 14px 16px;
    font-size: 15px;
    color: var(--text);
  }
</style>
